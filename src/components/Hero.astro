---
import { requireHomepage } from '../lib/sanity/homepage';

const home = await requireHomepage();
---
<section class="hero">
	<div class="container hero-content">
		<div class="hero-badge"><span class="dot"></span> {home.aboutEyebrow}</div>
		<h2 class="hero-title"><span class="highlight">{home.aboutHeadingHighlight}</span> {home.aboutHeading}</h2>
		<p>{home.aboutLead}</p>
		<div class="hero-stats">
			{home.aboutStats.map((stat) => (
				<div class="hero-stat">
					<div class="number">{stat.number}</div>
					<div class="label">{stat.label}</div>
				</div>
			))}
		</div>
		<p>{home.aboutBody}</p>
		<br>
		{home.aboutCtaLabel && home.aboutCtaUrl && (
			<a href={home.aboutCtaUrl} class="btn-primary-lg">{home.aboutCtaLabel}</a>
		)}
	</div>
</section>
