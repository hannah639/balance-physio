---
import { getGlobals } from '../lib/sanity/globals';

// Shared build-time fetch (memoised in globals.ts — no extra request).
const g = await getGlobals();
const nav = g.nav;

// Active-state helper, shared shape with the header.
const here = Astro.url.pathname;
const norm = (p) => (p.endsWith('/') ? p : `${p}/`);

// The main-clinic map link keeps its hard-coded Google Maps place URL: there is
// no CMS field for it, and localSeo.mapsUrl is not populated.
const mainClinicMapUrl = 'https://www.google.com/maps/place/Balance+Physio/@51.465003,-0.130667,2381m/data=!3m1!1e3!4m6!3m5!1s0x487604505fa09de1:0x4826f10ca0a3e7b1!8m2!3d51.465003!4d-0.130667!16s%2Fg%2F1tfm63rd';
---
<footer class="bp-footer">
	<div class="footer-main">
		<div class="container">
			<div class="footer-grid">
				<div class="footer-contact">
					<h4>Get in Touch</h4>
					<a href={g.phoneHref} class="phone">{g.phoneNumber}</a>
					<a href={`mailto:${g.email}`} class="email">{g.email}</a>
					<div class="address">
						<strong>Clapham North: Main Clinic</strong><br>
						<a href={mainClinicMapUrl} target="_blank" rel="noopener">{g.address}</a>
					</div>
					<div class="address">
						<strong>Clapham South for Hydrotherapy</strong><br>
						<a href="https://www.google.com/maps/place/Audley+Nightingale+Place/data=!4m2!3m1!1s0x0:0x9ad3c77ad81840c6" target="_blank" rel="noopener">Audley Village, Nightingale Place,<br>
						3 Nightingale Lane, London SW4 9AH</a>
					</div>
					<p class="address-note">For all appointments, please contact our main clinic, Gauden Road. Audley Village is for hydrotherapy only and all appointments should be booked via Gauden Road.</p>
					{/*
					  Map embed comes from Sanity (sanitised in globals.ts: iframe only,
					  no <script>, no inline handlers). Falls back to the original
					  hard-coded embed if the field is empty or fails sanitisation.
					  loading="lazy" is preserved either way — it keeps the map off the
					  critical path for LCP.
					*/}
					<div class="footer-map">
						{g.googleMapEmbed
							? <Fragment set:html={g.googleMapEmbed} />
							: <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2592.43136852671!2d-0.130667!3d51.465002999999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x487604505fa09de1%3A0x4826f10ca0a3e7b1!2sBalance%20Physio!5e1!3m2!1sen!2suk!4v1776443487865!5m2!1sen!2suk" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>}
					</div>
					<div class="social-links">
						<a href="https://www.facebook.com/BalancePerformanceLondon" class="social-link" target="_blank" rel="noopener" aria-label="Balance Performance Physiotherapy on Facebook">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M13.5 21v-8.4h2.82l.42-3.27H13.5V7.24c0-.95.26-1.6 1.62-1.6h1.73V2.71c-.3-.04-1.33-.13-2.52-.13-2.49 0-4.2 1.52-4.2 4.32v2.43H7.3v3.27h2.83V21h3.37z"/>
							</svg>
						</a>
						<a href="https://www.instagram.com/balanceperformancephysio/" class="social-link" target="_blank" rel="noopener" aria-label="Balance Performance Physiotherapy on Instagram">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 01-1.38-.9 3.7 3.7 0 01-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.21 8.8 2.2 12 2.2zm0 2.15c-3.15 0-3.5.01-4.73.07-1.07.05-1.65.23-2.04.38-.51.2-.88.44-1.26.82-.38.38-.62.75-.82 1.26-.15.39-.33.97-.38 2.04-.06 1.23-.07 1.58-.07 4.73s.01 3.5.07 4.73c.05 1.07.23 1.65.38 2.04.2.51.44.88.82 1.26.38.38.75.62 1.26.82.39.15.97.33 2.04.38 1.23.06 1.58.07 4.73.07s3.5-.01 4.73-.07c1.07-.05 1.65-.23 2.04-.38.51-.2.88-.44 1.26-.82.38-.38.62-.75.82-1.26.15-.39.33-.97.38-2.04.06-1.23.07-1.58.07-4.73s-.01-3.5-.07-4.73c-.05-1.07-.23-1.65-.38-2.04a3.4 3.4 0 00-.82-1.26 3.4 3.4 0 00-1.26-.82c-.39-.15-.97-.33-2.04-.38-1.23-.06-1.58-.07-4.73-.07zm0 3.66a4 4 0 110 8 4 4 0 010-8zm0 6.6a2.6 2.6 0 100-5.2 2.6 2.6 0 000 5.2zm5.1-6.76a.93.93 0 11-1.87 0 .93.93 0 011.87 0z"/>
							</svg>
						</a>
						<a href="https://x.com/balancePhysio" class="social-link" target="_blank" rel="noopener" aria-label="Balance Performance Physiotherapy on X">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M17.53 3H20.5l-6.5 7.43L21.75 21h-6l-4.69-6.14L5.69 21H2.72l6.95-7.94L2.25 3h6.15l4.24 5.6L17.53 3zm-1.05 16.2h1.64L7.6 4.7H5.84L16.48 19.2z"/>
							</svg>
						</a>
					</div>
				</div>
				{nav.footerGroups.map((grp) => (
					<div class="footer-col">
						<h4>{grp.title}</h4>
						<ul>
							{grp.items.map((item) => (
								<li><a
									href={item.href}
									target={item.newTab ? '_blank' : undefined}
									rel={item.newTab ? 'noopener' : undefined}
									aria-current={norm(item.href) === norm(here) ? 'page' : undefined}
								>{item.label}</a></li>
							))}
						</ul>
					</div>
				))}
			</div>
			<div class="footer-hours">
				<h4>Opening Hours</h4>
				<div class="hours-grid">
					{g.openingHours.map((row) => (
						<div class="hours-item">
							<div class="day">{row.day}</div>
							<div class="time">{row.hours}</div>
						</div>
					))}
				</div>
				<p class="hours-note">Strength &amp; conditioning training available earlier by appointment. Open on all Bank Holidays between March and September.</p>
			</div>
		</div>
	</div>

	<div class="footer-marquee">
		<div class="footer-marquee-inner">
			<span>Balance &middot; Recover &middot; Restore &middot; Perform &middot;</span>
			<span>Balance &middot; Recover &middot; Restore &middot; Perform &middot;</span>
			<span>Balance &middot; Recover &middot; Restore &middot; Perform &middot;</span>
			<span>Balance &middot; Recover &middot; Restore &middot; Perform &middot;</span>
			<span>Balance &middot; Recover &middot; Restore &middot; Perform &middot;</span>
			<span>Balance &middot; Recover &middot; Restore &middot; Perform &middot;</span>
			<span>Balance &middot; Recover &middot; Restore &middot; Perform &middot;</span>
			<span>Balance &middot; Recover &middot; Restore &middot; Perform &middot;</span>
			<span>Balance &middot; Recover &middot; Restore &middot; Perform &middot;</span>
			<span>Balance &middot; Recover &middot; Restore &middot; Perform &middot;</span>
			<span>Balance &middot; Recover &middot; Restore &middot; Perform &middot;</span>
			<span>Balance &middot; Recover &middot; Restore &middot; Perform &middot;</span>
		</div>
	</div>

	<div class="footer-bottom">
		<div class="footer-bottom-inner">
			<span>Designed & Developed by <a href="#">Balance Physio</a></span>
			<div class="footer-bottom-links">
				{nav.footerLegal.map((item) => (
				<a href={item.href} target={item.newTab ? '_blank' : undefined} rel={item.newTab ? 'noopener' : undefined}>{item.label}</a>
			))}
			</div>
			<span>&copy; 2026 Balance Performance Physiotherapy</span>
		</div>
	</div>
</footer>

<style>
	.bp-footer { background: #000000; color: rgba(255,255,255,0.7); padding: 0; font-family: 'Inter', sans-serif; }
	.bp-footer .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
	.footer-main { padding: 80px 0 48px; }
	.footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 48px; }
	.footer-contact p { font-size: 14px; line-height: 1.8; margin-bottom: 8px; }
	.footer-contact a { color: rgba(255,255,255,0.7); transition: color .2s; text-decoration: none; }
	.footer-contact a:hover { color: #ffffff; }
	.footer-contact .phone { font-size: 18px; font-weight: 700; color: #ffffff; margin-bottom: 12px; display: block; }
	.footer-contact .email { color: #3EBEDF; font-weight: 500; display: block; }
	.footer-contact .email:hover { color: #32a8c6; }
	.footer-contact .address { font-size: 14px; line-height: 1.7; margin: 16px 0; }
	.footer-contact .address a { color: inherit; text-decoration: none; transition: color .2s; }
	.footer-contact .address a:hover { color: var(--accent); text-decoration: underline; }
	.footer-contact .address-note { font-size: 13px; line-height: 1.6; margin: 0 0 16px 0; padding: 12px 14px; background: rgba(255,255,255,0.08); border-left: 3px solid #e87722; border-radius: 4px; color: rgba(255,255,255,0.85); }
	.footer-map {
		width: 100%; height: 160px; border-radius: 8px; overflow: hidden;
		margin: 16px 0; border: 1px solid rgba(255,255,255,0.15);
	}
	.footer-map iframe { width: 100%; height: 100%; border: 0; filter: grayscale(0.5); }
	.social-links { display: flex; gap: 12px; margin-top: 16px; }
	.social-link {
		width: 40px; height: 40px; border-radius: 8px;
		background: rgba(255,255,255,0.1); color: #ffffff;
		display: inline-flex; align-items: center; justify-content: center;
		transition: background .2s, transform .2s; text-decoration: none;
	}
	.social-link svg { width: 18px; height: 18px; display: block; }
	.social-link:hover { background: #3EBEDF; transform: translateY(-2px); }
	.bp-footer h4 { color: #ffffff; font-size: 14px; font-weight: 600; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 1px; }
	.bp-footer ul { list-style: none; margin: 0; padding: 0; }
	.bp-footer li { margin-bottom: 6px; }
	.bp-footer li a { font-size: 13px; transition: color .2s; color: rgba(255,255,255,0.7); text-decoration: none; }
	.bp-footer li a:hover { color: #ffffff; }
	.footer-hours { margin-top: 48px; padding-top: 32px; border-top: 1px solid rgba(255,255,255,0.1); }
	.footer-hours h4 { margin-bottom: 16px; }
	.hours-grid { display: flex; gap: 48px; flex-wrap: wrap; }
	.hours-item { font-size: 14px; }
	.hours-item .day { font-weight: 600; color: #ffffff; margin-bottom: 2px; }
	.hours-item .time { color: rgba(255,255,255,0.6); }
	.hours-note { margin-top: 20px; font-size: 13px; line-height: 1.6; color: rgba(255,255,255,0.55); max-width: 720px; }
	.footer-marquee {
		background: #e87722; padding: 16px 0; overflow: hidden; white-space: nowrap;
	}
	.footer-marquee-inner {
		display: inline-block; animation: bp-marqueeScroll 40s linear infinite;
	}
	.footer-marquee span {
		font-size: 16px; font-weight: 700; color: #ffffff; text-transform: uppercase;
		letter-spacing: 4px; padding: 0 48px;
	}
	@keyframes bp-marqueeScroll {
		0% { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}
	.footer-bottom {
		background: #111111; padding: 20px 0;
		font-size: 13px;
	}
	.footer-bottom-inner {
		max-width: 1200px; margin: 0 auto; padding: 0 24px;
		display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;
	}
	.footer-bottom a { color: rgba(255,255,255,0.5); transition: color .2s; text-decoration: none; }
	.footer-bottom a:hover { color: #ffffff; }
	.footer-bottom-links { display: flex; gap: 24px; }
	.footer-bottom span { color: rgba(255,255,255,0.4); }
	@media (max-width: 768px) {
		.footer-grid { grid-template-columns: 1fr; gap: 32px; }
		.hours-grid { gap: 24px; flex-direction: column; }
		.footer-bottom-inner { flex-direction: column; text-align: center; gap: 16px; }
		.footer-bottom-links { justify-content: center; }
	}
</style>
