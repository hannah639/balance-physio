---
import { bgImageSet } from '../lib/bgImage.js';
import { requireHomepage } from '../lib/sanity/homepage';

const home = await requireHomepage();

/** Fallback tint for a card with no background image, stable per title. */
function gradientFor(title) {
	var hash = 0;
	for (var i = 0; i < title.length; i++) hash = (hash << 5) - hash + title.charCodeAt(i);
	var hue = Math.abs(hash) % 360;
	return `linear-gradient(135deg, hsl(${hue}, 55%, 35%) 0%, hsl(${(hue + 50) % 360}, 60%, 22%) 100%)`;
}
---

<section class="features">
	<div class="container">
		<div class="section-header">
			<div class="hero-badge"><span class="dot"></span> {home.servicesEyebrow}</div>
			<h2><span class="highlight">{home.servicesHeadingHighlight}</span> {home.servicesHeading}</h2>
			<p>{home.servicesIntro}</p>
		</div>
		<div class="feature-list">
			{home.servicesCards.map((s) => (
				<a
					href={s.href}
					class="feature-card"
					style={s.image ? `` : `background: ${gradientFor(s.label)};`}
				>
					{s.image && <div class="feature-card-bg" style={bgImageSet(s.image.url)} />}
					<div class="feature-card-overlay"></div>
					<div class="feature-card-content">
						<div class="service-label">Service</div>
						<h3>{s.label}</h3>
					</div>
				</a>
			))}
		</div>
		<div class="feature-nav">
			<button class="feature-nav-btn" onclick="document.querySelector('.bp-page .feature-list').scrollBy({left:-344,behavior:'smooth'})">&larr;</button>
			<button class="feature-nav-btn" onclick="document.querySelector('.bp-page .feature-list').scrollBy({left:344,behavior:'smooth'})">&rarr;</button>
		</div>
	</div>
</section>
