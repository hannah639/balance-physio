---
import Picture from './Picture.astro';
import { requireHomepage } from '../lib/sanity/homepage';

const home = await requireHomepage();
---
<section class="image-quote-section">
	<div class="image-banner">
		{home.facilitiesImage && (
			<Picture src={home.facilitiesImage.url} alt={home.facilitiesImage.alt} loading="lazy" decoding="async" width="1400" height="1050" />
		)}
		<div class="image-banner-overlay">
			<div class="image-banner-content">
				<div class="hero-badge"><span class="dot"></span>{home.facilitiesEyebrow}</div>
				<h2>{home.facilitiesHeading}</h2>
				<p>{home.facilitiesText}</p>
				{home.facilitiesCtaLabel && home.facilitiesCtaUrl && (
					<a href={home.facilitiesCtaUrl} class="btn-outline-white">{home.facilitiesCtaLabel}</a>
				)}
			</div>
		</div>
	</div>
</section>
