---
import RichText from './RichText.astro';
import { requireHomepage } from '../lib/sanity/homepage';

const home = await requireHomepage();
---

<section class="clinics">
	<div class="container">
		<div class="clinics-header">
			<div class="clinics-header-left">
				<div class="hero-badge"><span class="dot"></span> {home.conditionsEyebrow}</div>
				<h2>{home.conditionsHeading}</h2>
			</div>
			<div class="clinics-header-right">
				<RichText blocks={home.conditionsIntro} />
			</div>
		</div>
		<div class="clinic-tags">
			{home.conditionsLinks.map((c, i) => (
				<a href={c.href} class={`clinic-tag${i % 2 === 1 ? ' alt' : ''}`}>{c.label}</a>
			))}
		</div>
	</div>
</section>
