---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import ImageText from './ImageText.astro';
import PhotoMarquee from './PhotoMarquee.astro';
import BookingCTA from './BookingCTA.astro';
import RichText from './RichText.astro';
import type { PageSection } from '../lib/sanity/pageContent';

/**
 * Shown by ImageText only when a section has no image. Positional, matching
 * the four blocks this component has always rendered; anything beyond reuses
 * the last label.
 */
const PLACEHOLDER_LABELS = ['Treatment in progress', 'Assessment', 'Treatment session', 'Our patients'];

const {
	title,
	highlight,
	heroSubtitle,
	breadcrumb,
	seoTitle,
	seoDescription,
	intro,          // array of paragraphs for intro block
	introYoutubeId, // optional YouTube video ID for lightbox on intro block
	introImage,     // optional image URL for intro block
	introImageAspect, // optional aspect-ratio override for intro image (e.g. '3/4')
	whenHeading = 'When to consider',
	whenHighlight = 'this service',
	whenIntro,      // string
	whenList,       // array
	whenOutro,      // optional closing paragraph rendered below the list
	whenImage,      // optional image URL
	whenImageAspect,
	howHeading = 'How we',
	howHighlight = 'treat',
	howIntro,
	howList,
	howOutro,      // optional closing block (HTML/string) rendered below the list
	howImage,       // optional image URL
	howImageAspect,
	whoHeading = 'Who we',
	whoHighlight = 'help',
	whoIntro,
	whoList,
	whoImage,       // optional image URL
	whoImageAspect,
	whoOutro,       // optional closing paragraph rendered below the list
	sections = [],   // CMS content sections; when present they replace the intro/when/how/who props
	faqs = [],
	marqueeImages, // optional array of {src, alt}, defaults to placeholder set
	marqueeSpeed = 45,
	hideMarquee = false, // pages that are text-only can set this true to drop the photo strip
	textGrid = false,    // render the 4 body sections as a 2x2 text-only grid instead of ImageText blocks
} = Astro.props;

/** Astro.props is untyped here, so name the shape the render loop relies on. */
const cmsSections: PageSection[] = sections;

// Default placeholder image set used when a page doesn't supply its own photos
const defaultPlaceholders = [
	{ src: '/placeholders/01.jpg', alt: '' },
	{ src: '/placeholders/02.jpg', alt: '' },
	{ src: '/placeholders/03.jpg', alt: '' },
	{ src: '/placeholders/04.jpg', alt: '' },
	{ src: '/placeholders/05.jpg', alt: '' },
	{ src: '/placeholders/06.jpg', alt: '' },
	{ src: '/placeholders/07.jpg', alt: '' },
	{ src: '/placeholders/08.jpg', alt: '' },
];
const photos = marqueeImages && marqueeImages.length > 0 ? marqueeImages : defaultPlaceholders;
---
<Layout title={seoTitle} description={seoDescription}>
	<PageHero title={title} highlight={highlight} subtitle={heroSubtitle} breadcrumb={breadcrumb} />

	{!hideMarquee && (
		<PhotoMarquee images={photos} heightPx={140} speedSeconds={marqueeSpeed} />
	)}

	<slot name="after-hero" />

	{textGrid ? (<>
		<section class="text-grid text-grid--light text-grid--split-top">
			<div class="text-grid-inner">
				{intro && intro.length > 0 && (
					<div class="image-text-content text-grid-cell">
						<div class="eyebrow">Our approach</div>
						<h2>Evidence-led <span class="highlight">care</span></h2>
						{intro.map((p) => <p>{p}</p>)}
					</div>
				)}
				{whenList && whenList.length > 0 && (
					<div class="image-text-content text-grid-cell">
						<div class="eyebrow">Symptoms</div>
						<h2>{whenHeading} <span class="highlight">{whenHighlight}</span></h2>
						{whenIntro && <p>{whenIntro}</p>}
						<ul>
							{whenList.map((item) => <li>{item}</li>)}
						</ul>
						{whenOutro && <p>{whenOutro}</p>}
					</div>
				)}
			</div>
		</section>
		<section class="text-grid text-grid--split-bottom">
			<div class="text-grid-inner">
				{howList && howList.length > 0 && (
					<div class="image-text-content text-grid-cell">
						<div class="eyebrow">Treatment</div>
						<h2>{howHeading} <span class="highlight">{howHighlight}</span></h2>
						{howIntro && <p>{howIntro}</p>}
						<ul>
							{howList.map((item) => <li>{item}</li>)}
						</ul>
						{howOutro && <p set:html={howOutro} />}
					</div>
				)}
				{whoList && whoList.length > 0 && (
					<div class="image-text-content text-grid-cell">
						<div class="eyebrow">Who we help</div>
						<h2>{whoHeading} <span class="highlight">{whoHighlight}</span></h2>
						{whoIntro && <p>{whoIntro}</p>}
						<ul>
							{whoList.map((item) => <li>{item}</li>)}
						</ul>
						{whoOutro && <p set:html={whoOutro} />}
					</div>
				)}
			</div>
		</section>
	</>) : cmsSections.length > 0 ? (<>
		{/* CMS-driven path. The eyebrows and the intro heading used to be
		    hard-coded here; they now live on each section so editors can change
		    them. Index 0 keeps the .service-intro wrapper and the optional
		    YouTube lightbox, matching the original markup exactly. */}
		{cmsSections.map((section, i) => (
			i === 0 ? (
				<div class="service-intro">
					<ImageText
						eyebrow={section.eyebrow ?? undefined}
						heading={section.heading ?? undefined}
						highlight={section.headingHighlight ?? undefined}
						placeholderLabel={PLACEHOLDER_LABELS[0]}
						youtubeId={introYoutubeId}
						image={section.image?.url ?? undefined}
						imageAlt={section.image?.alt ?? undefined}
						imageAspect={section.imageAspect ?? undefined}
					>
						<RichText blocks={section.blocks} />
					</ImageText>
				</div>
			) : (
				<ImageText
					eyebrow={section.eyebrow ?? undefined}
					heading={section.heading ?? undefined}
					highlight={section.headingHighlight ?? undefined}
					reverse={section.imageOnRight}
					altBg={section.altBackground}
					placeholderLabel={PLACEHOLDER_LABELS[i] ?? PLACEHOLDER_LABELS[PLACEHOLDER_LABELS.length - 1]}
					image={section.image?.url ?? undefined}
					imageAlt={section.image?.alt ?? undefined}
					imageAspect={section.imageAspect ?? undefined}
				>
					<RichText blocks={section.blocks} />
				</ImageText>
			)
		))}
	</>) : (<>
	{intro && intro.length > 0 && (
		<div class="service-intro">
			<ImageText
				eyebrow="Our approach"
				heading="Evidence-led"
				highlight="care"
				placeholderLabel="Treatment in progress"
				youtubeId={introYoutubeId}
				image={introImage}
				imageAspect={introImageAspect}
			>
				{intro.map((p) => <p>{p}</p>)}
			</ImageText>
		</div>
	)}

	{whenList && whenList.length > 0 && (
		<ImageText
			eyebrow="Symptoms"
			heading={whenHeading}
			highlight={whenHighlight}
			reverse
			altBg
			placeholderLabel="Assessment"
			image={whenImage}
			imageAspect={whenImageAspect}
		>
			{whenIntro && <p>{whenIntro}</p>}
			<ul>
				{whenList.map((item) => <li>{item}</li>)}
			</ul>
			{whenOutro && <p>{whenOutro}</p>}
		</ImageText>
	)}

	{howList && howList.length > 0 && (
		<ImageText
			eyebrow="Treatment"
			heading={howHeading}
			highlight={howHighlight}
			placeholderLabel="Treatment session"
			image={howImage}
			imageAspect={howImageAspect}
		>
			{howIntro && <p>{howIntro}</p>}
			<ul>
				{howList.map((item) => <li>{item}</li>)}
			</ul>
			{howOutro && <p set:html={howOutro} />}
		</ImageText>
	)}

	{whoList && whoList.length > 0 && (
		<ImageText
			eyebrow="Who we help"
			heading={whoHeading}
			highlight={whoHighlight}
			reverse
			altBg
			placeholderLabel="Our patients"
			image={whoImage}
			imageAspect={whoImageAspect}
		>
			{whoIntro && <p>{whoIntro}</p>}
			<ul>
				{whoList.map((item) => <li>{item}</li>)}
			</ul>
			{whoOutro && <p set:html={whoOutro} />}
		</ImageText>
	)}
	</>)}

	<slot name="before-faq" />

	{faqs.length > 0 && (
		<section class="faq-section">
			<div class="container">
				<div class="section-header">
					<h2>Frequently Asked Questions</h2>
				</div>
				<div class="faq-list">
					{faqs.map((item) => (
						<details class="faq-item">
							<summary>{item.q}</summary>
							<div class="answer"><RichText blocks={item.a} /></div>
						</details>
					))}
				</div>
			</div>
		</section>
	)}

	<BookingCTA />
</Layout>
