---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import ImageText from './ImageText.astro';
import BookingCTA from './BookingCTA.astro';
import RichText from './RichText.astro';
import type { Condition } from '../lib/sanity/conditions';

const { doc } = Astro.props as { doc: Condition };

const faqs = doc.faqs;
---
<Layout title={doc.seoTitle ?? doc.title} description={doc.seoDescription ?? undefined}>
	<PageHero
		title={doc.heroHeading}
		highlight={doc.heroHighlight ?? undefined}
		subtitle={doc.heroSubtitle ?? undefined}
		breadcrumb={doc.breadcrumb ?? undefined}
	/>

	{doc.body.length > 0 && (
		<ImageText
			eyebrow="Our approach"
			heading="Expert clinical"
			highlight="care"
			altBg
			placeholderLabel="Clinical assessment"
			image={doc.introImage?.url ?? undefined}
			imageAlt={doc.introImage?.alt ?? undefined}
			imageAspect={doc.introImageAspect ?? undefined}
		>
			<RichText blocks={doc.body} />
		</ImageText>
	)}

	{(doc.symptoms.length > 0 || doc.treatmentList.length > 0) && (
		<section class="text-grid text-grid--light">
			<div class="text-grid-inner">
				{doc.symptoms.length > 0 && (
					<div class="image-text-content text-grid-cell">
						<div class="eyebrow">Symptoms</div>
						<h2>{doc.symptomsHeading} <span class="highlight">{doc.symptomsHighlight}</span></h2>
						{doc.symptomsIntro && <p>{doc.symptomsIntro}</p>}
						<ul>
							{doc.symptoms.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				)}
				{doc.treatmentList.length > 0 && (
					<div class="image-text-content text-grid-cell text-grid-cell--treatment">
						<div class="eyebrow">Treatment</div>
						<h2>{doc.treatmentHeading} <span class="highlight">{doc.treatmentHighlight}</span></h2>
						{doc.treatmentIntro && <p>{doc.treatmentIntro}</p>}
						<ul>
							{doc.treatmentList.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				)}
			</div>
		</section>
	)}

	{doc.whoList.length > 0 && (
		<ImageText
			eyebrow="Who we help"
			heading={doc.whoHeading ?? undefined}
			highlight={doc.whoHighlight ?? undefined}
			reverse
			altBg
			placeholderLabel="Our patients"
			image={doc.whoImage?.url ?? undefined}
			imageAlt={doc.whoImage?.alt ?? undefined}
			imageAspect={doc.whoImageAspect ?? undefined}
		>
			{doc.whoIntro && <p>{doc.whoIntro}</p>}
			<ul>
				{doc.whoList.map((item) => <li>{item}</li>)}
			</ul>
		</ImageText>
	)}

	{faqs.length > 0 && (
		<section class="faq-section">
			<div class="container">
				<div class="section-header">
					<h2>Frequently Asked Questions</h2>
				</div>
				<div class="faq-list">
					{faqs.map((item) => (
						<details class="faq-item">
							<summary>{item.question}</summary>
							<div class="answer"><RichText blocks={item.answer} /></div>
						</details>
					))}
				</div>
			</div>
		</section>
	)}

	<BookingCTA />
</Layout>
