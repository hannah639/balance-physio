---
import { bgImageSet } from '../lib/bgImage.js';
import { getGlobals } from '../lib/sanity/globals';

const g = await getGlobals();

// Copy comes from the first Booking Links card when one is set, else the
// section keeps the wording it shipped with.
//
// The background stays on the LOCAL /booking-banner.jpg unless an editor
// uploads a CMS image — that preserves the existing AVIF/WebP image-set
// optimisation on what is the LCP element for most pages.
const card = g.bookingCards[0] ?? null;
const eyebrow = card?.eyebrow ?? 'Booking';
const heading = card?.title ?? 'Ready To Book?';
const body = card?.text ?? 'When you are ready to start your rehabilitation journey we are here to help! You can book online straight away or alternatively please get in touch if you have any questions.';
const bgStyle = card?.bgImage?.url
	? `background-image: url('${card.bgImage.url}');`
	: bgImageSet('/booking-banner.jpg');
---
<section class="booking-cta">
	<div class="booking-cta-bg" style={bgStyle}></div>
	<div class="booking-cta-overlay"></div>
	<div class="booking-cta-inner">
		<div class="hero-badge"><span class="dot"></span> {eyebrow}</div>
		<h2>{heading}</h2>
		<p>{body}</p>
		<div class="booking-cta-actions">
			<a href={card?.url ?? g.bookingUrl} target="_blank" rel="noopener" class="btn-book" aria-label={card?.ariaLabel ?? undefined}>{card?.ctaLabel ?? g.bookingLabel}</a>
			<a href="/contact-us/" class="btn-outline-white btn-outline-white--lg">Contact Us</a>
		</div>
	</div>
</section>

<style>
	.booking-cta {
		position: relative;
		overflow: hidden;
		background: #1a1a1a;
		color: #ffffff;
		padding: 120px 48px;
		min-height: 70vh;
		display: flex;
		align-items: center;
	}
	.booking-cta-bg {
		position: absolute; inset: 0;
		background-size: cover;
		background-position: center top;
		z-index: 0;
	}
	.booking-cta-overlay {
		position: absolute; inset: 0;
		background: rgba(0, 0, 0, 0.55);
		z-index: 1;
	}
	.booking-cta-inner {
		position: relative; z-index: 2;
		max-width: 700px;
		margin: 0;
		text-align: left;
	}
	.booking-cta-inner .hero-badge {
		display: inline-flex; align-items: center; gap: 8px;
		background: rgba(255,255,255,0.1);
		border: 1px solid rgba(255,255,255,0.2);
		border-radius: 50px;
		padding: 6px 16px;
		font-size: 13px; font-weight: 500;
		margin-bottom: 24px;
		color: rgba(255,255,255,0.85);
	}
	.booking-cta-inner .hero-badge .dot {
		width: 8px; height: 8px; border-radius: 50%;
		background: #3EBEDF;
	}
	.booking-cta-inner h2 {
		font-size: 42px; font-weight: 800;
		letter-spacing: -1px;
		line-height: 1.15;
		margin-bottom: 20px;
		color: #ffffff;
	}
	.booking-cta-inner p {
		font-size: 17px;
		line-height: 1.7;
		color: rgba(255,255,255,0.85);
		margin-bottom: 32px;
	}
	.booking-cta-actions {
		display: flex; gap: 16px; flex-wrap: wrap; align-items: center;
	}
	/* Larger variant to match the .btn-book sibling's height in this CTA */
	.btn-outline-white--lg { padding: 18px 36px !important; font-size: 17px !important; }
	@media (max-width: 768px) {
		.booking-cta { padding: 64px 20px; min-height: 0; }
		.booking-cta-inner h2 { font-size: 30px; }
		.booking-cta-inner p { font-size: 16px; margin-bottom: 24px; }
		.booking-cta-actions .btn-book,
		.booking-cta-actions .btn-outline-white { flex: 1; min-width: 140px; text-align: center; padding: 14px 20px; }
	}
</style>
