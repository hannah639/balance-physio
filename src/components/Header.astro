---
import Picture from './Picture.astro';
import { bgImageSet } from '../lib/bgImage.js';
import { getGlobals } from '../lib/sanity/globals';

// Shared build-time fetch — see src/lib/sanity/globals.ts (memoised, so this
// does not add a request per component).
const g = await getGlobals();

// Navigation comes from Sanity → Navigation (single source of truth for the
// header, the mobile menu and the footer). Resolved at build time inside the
// shared getGlobals() fetch, so there is no extra request and no client JS.
const nav = g.nav;
const desktopEntries = nav.header.filter((e) => e.showInHeader);
const mobileEntries = nav.header.filter((e) => e.showInMobile);

// Active state: mark the entry whose own link, or any of whose child links,
// matches the current URL.
const here = Astro.url.pathname;
const norm = (p) => (p.endsWith('/') ? p : `${p}/`);
const entryIsCurrent = (e) =>
	(e.link && norm(e.link.href) === norm(here)) ||
	e.groups.some((grp) => grp.items.some((i) => norm(i.href) === norm(here)));
---
<header class="bp-header">
	<div class="header-inner">
		<a href="/" class="logo" aria-label={`${g.siteName} home`}>
			{/*
			  Logo from Sanity Site Settings, falling back to the local /logo.jpg.
			  Still routed through <Picture>: for the local fallback it emits the
			  existing AVIF/WebP <source> set, and for a Sanity CDN URL it emits a
			  plain <img> (no local variants exist for a remote file).
			*/}
			<Picture
				src={g.logo.url}
				alt={g.logo.alt}
				decoding="async"
				width={g.logo.width ?? 500}
				height={g.logo.height ?? 176}
			/>
		</a>
		<nav>
			<ul>
				{desktopEntries.map((entry) => (
					entry.groups.length === 0 ? (
						<li>
							<a
								href={entry.link?.href}
								target={entry.link?.newTab ? '_blank' : undefined}
								rel={entry.link?.newTab ? 'noopener' : undefined}
								aria-current={entryIsCurrent(entry) ? 'page' : undefined}
							>{entry.label}</a>
						</li>
					) : entry.dropdownStyle === 'columns' ? (
						<li class="has-dropdown has-dropdown-services-mega">
							<a href={entry.link?.href ?? '#'} aria-current={entryIsCurrent(entry) ? 'page' : undefined}>{entry.label} <span class="chev">▾</span></a>
							<div class="dropdown dropdown-services-mega">
								<div class="services-mega-inner">
									{[1, 2, 3, 4].map((colNo) => {
										const cols = entry.groups.filter((grp) => (grp.column ?? 1) === colNo);
										return cols.length ? (
											<div class="services-col">
												{cols.map((grp) => (
													<div class="services-group">
														<div class="services-group-label">
															{grp.title}
															{grp.sublabel && <><br/><span class="services-group-sublabel">{grp.sublabel}</span></>}
														</div>
														{grp.items.map((item) => (
															<a href={item.href} target={item.newTab ? '_blank' : undefined} rel={item.newTab ? 'noopener' : undefined} aria-current={norm(item.href) === norm(here) ? 'page' : undefined}>{item.label}</a>
														))}
													</div>
												))}
											</div>
										) : null;
									})}
								</div>
							</div>
						</li>
					) : entry.dropdownStyle === 'feature' ? (
						<li class="has-dropdown has-dropdown-mega">
							<a href={entry.link?.href ?? '#'} onclick={entry.link ? undefined : 'return false;'} aria-current={entryIsCurrent(entry) ? 'page' : undefined}>{entry.label} <span class="chev">▾</span></a>
							<div class="dropdown dropdown-mega">
								<div class="mega-left">
									<div class="mega-eyebrow">{entry.introEyebrow ?? entry.label}</div>
									{entry.introText && <p class="mega-intro">{entry.introText}</p>}
									<div class="mega-links">
										{entry.groups.flatMap((grp) => grp.items).map((item) => (
											<a href={item.href} target={item.newTab ? '_blank' : undefined} rel={item.newTab ? 'noopener' : undefined} aria-current={norm(item.href) === norm(here) ? 'page' : undefined}>{item.label}</a>
										))}
									</div>
								</div>
								{entry.cardImagePath && (
									entry.cardUsesBookingLink
										? <a href={g.bookingUrl} target="_blank" rel="noopener" class="mega-card" style={bgImageSet(entry.cardImagePath)}>
												<span class="mega-card-button">{g.bookingLabel}</span>
											</a>
										: <a href={entry.link?.href ?? entry.groups[0]?.items[0]?.href} class="mega-card" style={bgImageSet(entry.cardImagePath)} aria-label={`Visit our ${entry.label} page`}></a>
								)}
							</div>
						</li>
					) : (
						<li class={entry.dropdownStyle === 'wide' ? 'has-dropdown has-dropdown-wide' : 'has-dropdown'}>
							<a href={entry.link?.href ?? '#'} aria-current={entryIsCurrent(entry) ? 'page' : undefined}>{entry.label} <span class="chev">▾</span></a>
							<div class={entry.dropdownStyle === 'wide' ? 'dropdown dropdown-wide' : 'dropdown'}>
								{entry.groups.flatMap((grp) => grp.items).map((item) => (
									<a href={item.href} target={item.newTab ? '_blank' : undefined} rel={item.newTab ? 'noopener' : undefined} aria-current={norm(item.href) === norm(here) ? 'page' : undefined}>{item.label}</a>
								))}
							</div>
						</li>
					)
				))}
			</ul>
		</nav>
		<div class="header-cta">
			<a href={g.bookingUrl} target="_blank" rel="noopener" class="btn-primary">Book Now</a>
			<button class="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
	</div>
</header>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
	<div class="mobile-menu-inner">
		<ul class="mobile-nav">
			{mobileEntries.map((entry) => (
				entry.groups.length === 0 ? (
					<li>
						<a
							href={entry.link?.href}
							class="mobile-direct"
							target={entry.link?.newTab ? '_blank' : undefined}
							rel={entry.link?.newTab ? 'noopener' : undefined}
							aria-current={entryIsCurrent(entry) ? 'page' : undefined}
						>{entry.label}</a>
					</li>
				) : (
					<li>
						<details>
							<summary>{entry.label}</summary>
							<ul class="mobile-sublist">
								{entry.dropdownStyle === 'columns'
									? entry.groups.map((grp) => (
										<>
											<li class="mobile-sublist-category">{grp.title}{grp.sublabel && <> {grp.sublabel}</>}</li>
											{grp.items.map((item) => (
												<li><a href={item.href} target={item.newTab ? '_blank' : undefined} rel={item.newTab ? 'noopener' : undefined} aria-current={norm(item.href) === norm(here) ? 'page' : undefined}>{item.label}</a></li>
											))}
										</>
									))
									: entry.groups.flatMap((grp) => grp.items).map((item) => (
										<li><a href={item.href} target={item.newTab ? '_blank' : undefined} rel={item.newTab ? 'noopener' : undefined} aria-current={norm(item.href) === norm(here) ? 'page' : undefined}>{item.label}</a></li>
									))}
							</ul>
						</details>
					</li>
				)
			))}
		</ul>
		<a href={g.bookingUrl} target="_blank" rel="noopener" class="mobile-menu-book">Book Now</a>
	</div>
</div>

<style>
	.bp-header {
		position: fixed; top: 0; left: 0; right: 0; z-index: 100;
		background: transparent;
		border-bottom: 1px solid rgba(255,255,255,0.15);
		transition: background .3s ease, border-color .3s ease, box-shadow .3s ease;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}
	.bp-header.is-scrolled {
		background: rgba(44, 67, 86, 0.96);
		border-bottom: 1px solid rgba(255,255,255,0.08);
		box-shadow: 0 4px 20px rgba(0,0,0,0.15);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}
	.header-inner {
		display: flex; align-items: center; justify-content: space-between;
		padding: 16px 24px; max-width: 1200px; margin: 0 auto;
	}
	.logo {
		display: inline-flex; align-items: center;
		text-decoration: none;
	}
	.logo img {
		height: 52px; width: auto; display: block;
	}
	nav ul { display: flex; gap: 32px; list-style: none; margin: 0; padding: 0; align-items: center; }
	nav > ul > li { position: relative; }
	nav a { font-weight: 500; font-size: 15px; color: rgba(255,255,255,0.85); transition: color .2s; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
	nav a:hover { color: #ffffff; }
	.chev { font-size: 10px; opacity: 0.7; }

	.has-dropdown .dropdown {
		position: absolute; top: 100%; left: 0;
		background: #ffffff;
		border-radius: 12px;
		box-shadow: 0 12px 40px rgba(0,0,0,0.18);
		min-width: 220px;
		padding: 12px;
		opacity: 0; visibility: hidden;
		transform: translateY(8px);
		transition: opacity .2s, transform .2s, visibility .2s;
		z-index: 200;
		display: flex; flex-direction: column; gap: 2px;
	}
	.has-dropdown .dropdown.dropdown-wide {
		display: grid;
		grid-template-columns: repeat(3, minmax(180px, 1fr));
		min-width: 600px;
		padding: 16px;
		gap: 4px 20px;
	}

	/* Services mega menu (4 columns, categorised) */
	.has-dropdown-services-mega .dropdown.dropdown-services-mega {
		min-width: 920px;
		padding: 0;
		left: 50%;
		transform: translateX(-50%) translateY(8px);
	}
	.has-dropdown-services-mega:hover .dropdown.dropdown-services-mega,
	.has-dropdown-services-mega:focus-within .dropdown.dropdown-services-mega {
		transform: translateX(-50%) translateY(0);
	}
	.services-mega-inner {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 28px 36px;
		padding: 32px 36px 36px;
	}
	.services-col { display: flex; flex-direction: column; gap: 28px; }
	.services-group { display: flex; flex-direction: column; gap: 2px; }
	.services-group-label {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #e87722;
		line-height: 1.35;
		margin-bottom: 10px;
	}
	.services-group-sublabel {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #e87722;
	}
	.services-group a {
		display: block;
		padding: 6px 10px;
		margin-left: -10px;
		border-radius: 6px;
		font-size: 14px;
		font-weight: 500;
		color: #1a1a1a;
		text-decoration: none;
		line-height: 1.4;
		transition: background .15s, color .15s;
	}
	.services-group a:hover {
		background: #f4f6f7;
		color: #e87722;
	}

	/* Mobile category heading within Services */
	.mobile-sublist .mobile-sublist-category {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #e87722;
		padding: 16px 0 6px;
		list-style: none;
	}

	/* Mega menu (Who We Help) */
	.has-dropdown-mega .dropdown.dropdown-mega {
		display: grid;
		grid-template-columns: minmax(320px, 1fr) 280px;
		min-width: 640px;
		left: auto;
		right: 0;
		padding: 0;
		gap: 0;
		overflow: hidden;
	}
	.dropdown-mega .mega-left {
		padding: 28px 28px 24px;
		display: flex;
		flex-direction: column;
	}
	.dropdown-mega .mega-eyebrow {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #e87722;
		margin-bottom: 12px;
	}
	.dropdown-mega .mega-intro {
		font-size: 14px;
		line-height: 1.5;
		color: #4b5563;
		margin: 0 0 18px;
	}
	.dropdown-mega .mega-links {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.dropdown-mega .mega-links a {
		padding: 10px 12px;
		border-radius: 8px;
		font-size: 14px;
		font-weight: 600;
		color: #1a1a1a;
		transition: background .15s, color .15s;
	}
	.dropdown-mega .mega-links a:hover {
		background: #3EBEDF;
		color: #ffffff;
	}
	.dropdown-mega .mega-card {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		min-height: 260px;
		text-decoration: none;
		overflow: hidden;
		padding: 20px;
		border-radius: 0;
		font-size: inherit;
		font-weight: inherit;
		transform: none;
		transition: none;
	}
	.dropdown-mega .mega-card::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0,0,0,0.45) 0%, rgba(0,0,0,0.15) 40%, rgba(0,0,0,0) 70%);
		pointer-events: none;
	}
	.dropdown-mega .mega-card:hover,
	.dropdown-mega .mega-card:focus,
	.dropdown-mega .mega-card:active {
		background-color: transparent;
		background-size: cover;
		background-position: center;
		transform: none;
	}
	.dropdown-mega .mega-card-button {
		position: relative;
		z-index: 1;
		display: inline-block;
		padding: 12px 28px;
		background: #3EBEDF;
		color: #ffffff;
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.03em;
		border-radius: 50px;
		transition: background .2s ease, transform .15s ease;
	}
	.dropdown-mega .mega-card:hover .mega-card-button {
		background: #32a8c6;
		transform: translateY(-2px);
	}
	.dropdown-mega .mega-card-overlay {
		width: 100%;
		padding: 20px;
		background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.25) 60%, rgba(0,0,0,0) 100%);
		color: #ffffff;
	}
	.dropdown-mega .mega-card-title {
		font-size: 22px;
		font-weight: 700;
		line-height: 1.2;
		margin-bottom: 8px;
		color: #ffffff;
	}
	.dropdown-mega .mega-card-cta {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #ffffff;
		opacity: 0.95;
	}
	.dropdown-mega .mega-card:hover .mega-card-cta {
		opacity: 1;
	}

	.has-dropdown .dropdown a {
		color: #1a1a1a;
		padding: 8px 12px;
		border-radius: 8px;
		font-size: 14px;
		font-weight: 500;
		transition: background-color .15s, color .15s;
	}
	.has-dropdown .dropdown a:hover {
		background-color: #f4f6f7;
		color: #e87722;
	}
	.has-dropdown:hover .dropdown,
	.has-dropdown:focus-within .dropdown {
		opacity: 1; visibility: visible; transform: translateY(0);
	}

	.header-cta { display: flex; gap: 12px; align-items: center; }
	.header-cta .btn-primary {
		padding: 10px 24px; border-radius: 50px; font-weight: 600; font-size: 14px;
		color: #ffffff; background: #3EBEDF; border: none;
		cursor: pointer; transition: all .2s; text-decoration: none;
		display: inline-block;
	}
	.header-cta .btn-primary:hover { background: #32a8c6; }

	/* Hamburger button, hidden on desktop */
	.hamburger {
		display: none;
		background: transparent;
		border: 0;
		padding: 8px;
		cursor: pointer;
		width: 40px; height: 40px;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
	}
	.hamburger span {
		display: block;
		width: 22px; height: 2px;
		background: #ffffff;
		border-radius: 2px;
		transition: transform .25s, opacity .2s;
	}
	.hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
	.hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
	.hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

	@media (max-width: 900px) {
		nav ul { display: none; }
		.hamburger { display: inline-flex; }
		.header-cta .btn-primary { display: none; }
	}
</style>

<style is:global>
	/* Mobile full-screen menu panel (outside Header scope, so global).
	   The `body` prefix on every selector is intentional — it lifts these
	   rules above the homepage's `.bp-page *` universal reset (in
	   src/pages/index.astro) which would otherwise zero out the padding
	   inside the menu and visibly break the layout on the homepage only. */
	body .mobile-menu {
		position: fixed; top: 0; left: 0; right: 0; bottom: 0;
		background: #2c4356;
		z-index: 99;
		padding-top: 90px;
		overflow-y: auto;
		opacity: 0; visibility: hidden;
		transition: opacity .25s ease, visibility .25s ease;
		font-family: 'Inter', sans-serif;
	}
	body .mobile-menu.is-open { opacity: 1; visibility: visible; }
	body .mobile-menu-inner { padding: 16px 24px 48px; max-width: 640px; margin: 0 auto; }
	body .mobile-nav { list-style: none; margin: 0; padding: 0; }
	body .mobile-nav > li {
		border-bottom: 1px solid rgba(255,255,255,0.1);
	}
	body .mobile-nav details > summary {
		list-style: none;
		padding: 16px 0;
		font-size: 18px;
		font-weight: 600;
		color: #ffffff;
		cursor: pointer;
		display: flex; justify-content: space-between; align-items: center;
	}
	body .mobile-nav details > summary::-webkit-details-marker { display: none; }
	body .mobile-nav details > summary::after {
		content: '+';
		font-size: 26px; font-weight: 400;
		color: #e87722;
		transition: transform .2s;
	}
	body .mobile-nav details[open] > summary::after { transform: rotate(45deg); }
	body .mobile-sublist {
		list-style: none; margin: 0; padding: 0 0 16px 12px;
	}
	body .mobile-sublist li { padding: 0; }
	body .mobile-sublist a {
		display: block;
		padding: 10px 0;
		font-size: 15px;
		color: rgba(255,255,255,0.8);
		text-decoration: none;
	}
	body .mobile-sublist a:hover, body .mobile-sublist a:active { color: #e87722; }
	/* These two rules need .mobile-menu in the selector (not just `body`) to
	   beat the homepage's `.bp-page a { color: inherit }` rule on specificity.
	   Without .mobile-menu in the chain we tie at 0,1,1 and lose on source
	   order — making FAQs / Contact Us / Book Now inherit black on the
	   homepage only. With it we sit at 0,2,1 and win cleanly. */
	body .mobile-menu .mobile-direct {
		display: block;
		padding: 16px 0;
		font-size: 18px; font-weight: 600;
		color: #ffffff;
		text-decoration: none;
	}
	body .mobile-menu .mobile-menu-book {
		display: block;
		margin-top: 28px;
		padding: 16px 24px;
		background: #e87722;
		color: #ffffff;
		text-align: center;
		font-size: 16px; font-weight: 700;
		border-radius: 50px;
		text-decoration: none;
	}
	body .mobile-menu .mobile-menu-book:hover { background: #d06618; }
</style>

<script is:inline>
	(function () {
		var btn = document.querySelector('.hamburger');
		var menu = document.getElementById('mobile-menu');
		if (!btn || !menu) return;
		function setOpen(open) {
			btn.setAttribute('aria-expanded', open ? 'true' : 'false');
			menu.setAttribute('aria-hidden', open ? 'false' : 'true');
			menu.classList.toggle('is-open', open);
			document.body.style.overflow = open ? 'hidden' : '';
		}
		btn.addEventListener('click', function () {
			var isOpen = btn.getAttribute('aria-expanded') === 'true';
			setOpen(!isOpen);
		});
		// Close menu when a sub-link is clicked
		menu.addEventListener('click', function (e) {
			var a = e.target.closest('a');
			if (a) setOpen(false);
		});
		// Close on Escape
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape') setOpen(false);
		});
	})();
</script>

<script is:inline>
	(function () {
		var header = document.querySelector('.bp-header');
		if (!header) return;
		function onScroll() {
			if (window.scrollY > 20) header.classList.add('is-scrolled');
			else header.classList.remove('is-scrolled');
		}
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	})();
</script>
