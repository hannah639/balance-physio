---
import { requireHomepage } from '../lib/sanity/homepage';

const home = await requireHomepage();
---
<section class="problem">
	<div class="container">
		<div class="section-header">
			<h2><span class="highlight">{home.approachHeadingHighlight}</span><br>{home.approachHeading}</h2>
			<p>{home.approachIntro}</p>
		</div>
		<div class="problem-grid">
			{home.approachSteps.map((step, i) => (
				<>
					{/* Arrow between cards, not before the first one. */}
					{i > 0 && <div class="problem-arrow">&#10140;</div>}
					<div class={`problem-card${step.featured ? ' featured' : ''}`}>
						{step.icon && <div class="icon">{step.icon}</div>}
						<div class="step-row">
							<span class="step-label">Step <span class="step-num">{String(i + 1).padStart(2, '0')}</span></span>
							<span class="step-tag">{step.tag}</span>
						</div>
						<h3>{step.heading}</h3>
						<ul class="bullet-list">
							{step.bullets.map((b) => <li>{b}</li>)}
						</ul>
					</div>
				</>
			))}
		</div>
	</div>
</section>
