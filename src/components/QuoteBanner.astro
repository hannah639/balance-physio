---
import Picture from './Picture.astro';
import { requireHomepage } from '../lib/sanity/homepage';

const home = await requireHomepage();
---
<section class="image-quote-section">
	<div class="image-banner image-banner-quote">
		{home.quoteImage && (
			<Picture src={home.quoteImage.url} alt={home.quoteImage.alt} loading="lazy" decoding="async" width="1400" height="934" />
		)}
		<div class="image-banner-overlay" style="justify-content: center;">
			<div class="container" style="text-align: center; max-width: 900px;">
				<div class="image-quote-mark">&ldquo;</div>
				<blockquote style="font-size: 28px; font-weight: 700; line-height: 1.5; color: var(--white); font-style: italic; margin-bottom: 32px;">{home.quoteText}</blockquote>
				<div style="width: 80px; height: 2px; background: rgba(255,255,255,0.3); margin: 0 auto 24px;"></div>
				<cite style="font-size: 16px; font-style: normal; font-weight: 500; color: var(--accent);">{home.quoteAttribution}</cite>
			</div>
		</div>
	</div>
</section>
