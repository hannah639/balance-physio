---
import Picture from './Picture.astro';
import { requireHomepage } from '../lib/sanity/homepage';

const home = await requireHomepage();
---
<section class="activities">
	<div class="container">
		<div class="section-header">
			<div class="hero-badge" style="background: rgba(0,0,0,0.06); border-color: rgba(0,0,0,0.1); color: var(--text-muted);"><span class="dot" style="background: var(--accent);"></span> {home.activitiesEyebrow}</div>
			<h2>{home.activitiesHeading}</h2>
			<p>{home.activitiesIntro}</p>
		</div>
		<div class="activities-slider" id="activitiesSlider">
			{home.activitiesSlides.map((slide) => (
				<div class="activities-slide"><Picture src={slide.url} alt={slide.alt} loading="lazy" decoding="async" width="600" height="400" /></div>
			))}
		</div>
	</div>
</section>
