---
/**
 * One post in the news grid. Every value comes from Sanity; a post with no
 * featured image still renders a valid card rather than a broken frame.
 */
import Picture from './Picture.astro';
import type {BlogCard} from '../lib/sanity/blog';

const {post} = Astro.props as {post: BlogCard};
---
<article class="blog-card">
	<a class="blog-card-link" href={post.url} aria-label={post.title}>
		<div class="blog-card-media">
			{post.image ? (
				<Picture
					src={post.image.url}
					alt={post.image.alt}
					loading="lazy"
					decoding="async"
					width="600"
					height="400"
				/>
			) : (
				<div class="blog-card-placeholder" aria-hidden="true"></div>
			)}
		</div>
		<div class="blog-card-body">
			{post.categories.length > 0 && (
				<div class="blog-card-meta">
					{post.categories.map((c) => <span class="blog-card-tag">{c.title}</span>)}
				</div>
			)}
			<h2 class="blog-card-title">{post.title}</h2>
			{post.excerpt && <p class="blog-card-excerpt">{post.excerpt}</p>}
			<div class="blog-card-foot">
				{post.dateISO
					? <time datetime={post.dateISO}>{post.dateLabel}</time>
					: <span>{post.dateLabel}</span>}
				<span class="blog-card-more">Read more &rarr;</span>
			</div>
		</div>
	</a>
</article>

<style>
	.blog-card {
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--card-shadow);
		transition: transform .2s, box-shadow .2s;
		height: 100%;
	}
	.blog-card:hover { transform: translateY(-4px); box-shadow: 0 10px 28px rgba(0,0,0,.14); }
	.blog-card-link { display: flex; flex-direction: column; height: 100%; color: inherit; }
	.blog-card-media { aspect-ratio: 3 / 2; overflow: hidden; background: var(--primary-bg); }
	.blog-card-media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
	.blog-card-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, var(--primary-bg) 0%, var(--primary-bg-gradient) 100%); }
	.blog-card-body { display: flex; flex-direction: column; gap: 10px; padding: 22px 24px 24px; flex: 1; }
	.blog-card-meta { display: flex; flex-wrap: wrap; gap: 8px; }
	.blog-card-tag {
		font-size: 12px; font-weight: 600; letter-spacing: .3px;
		color: var(--primary); background: var(--primary-bg);
		border-radius: 50px; padding: 4px 12px;
	}
	.blog-card-title { font-size: 20px; font-weight: 700; line-height: 1.3; letter-spacing: -.3px; }
	.blog-card-excerpt { font-size: 15px; line-height: 1.65; color: var(--text-muted); }
	.blog-card-foot {
		margin-top: auto; padding-top: 12px;
		display: flex; align-items: center; justify-content: space-between; gap: 12px;
		font-size: 13px; color: var(--text-muted);
	}
	.blog-card-more { color: var(--accent); font-weight: 600; }
	@media (max-width: 480px) {
		.blog-card-title { font-size: 18px; }
	}
</style>
