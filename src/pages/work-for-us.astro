---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ImageText from '../components/ImageText.astro';
import BookingCTA from '../components/BookingCTA.astro';
import { pages } from '../lib/sanity/pageContent';

// Hero and SEO come from Sanity -> Pages. Bespoke sections below stay in
// this file; see the completion notes for which pages are fully migrated.
// This page's body is CMS-driven, so a missing document must fail the
// build rather than render an empty page.
const doc = await pages.required('work-for-us');

// Vacancies come from Sanity → Pages → Work For Us → Open roles.
const roles = doc.openRoles ?? [];
---
<Layout title={doc?.seoTitle ?? "Work For Us"} description={doc?.seoDescription ?? "Interested in joining Balance Performance Physiotherapy? We're currently recruiting a Soft Tissue Therapist, Hydrotherapist and Saturday Pilates Instructor."}>
	<PageHero
		title={doc?.heroHeading ?? "For Us"}
		highlight={doc?.heroHighlight ?? "Work"}
		subtitle={doc?.heroSubtitle ?? "Interested in working for Balance? We're always on the lookout for exceptional new additions to our fantastic team."}
		breadcrumb={doc?.breadcrumb ?? "Work For Us"}
		bgImage={doc?.heroImageUrl ?? undefined}
		ctaText="Get in touch"
		ctaHref="/contact-us"
	/>

	<section class="roles-section">
		<div class="container">
			<p class="roles-eyebrow">Current roles</p>
			<h2 class="roles-title">Open <span class="roles-title-accent">positions</span></h2>
			<p class="roles-intro">We're currently recruiting for the roles below. Tap a role to read the full description.</p>
			<div class="roles-list">
				{roles.map((role) => (
					<details class="role-item">
						<summary>
							<span class="role-name">{role.title}</span>
							<span class="role-meta">{role.meta}</span>
						</summary>
						{/* Rendered from Portable Text rather than set:html — no raw
						    CMS markup reaches the page. */}
						<div class="role-body">
							{role.body.map((block) => (
								block.kind === 'p'
									? <p>{block.text}</p>
									: <ul>{block.items.map((i) => <li>{i}</li>)}</ul>
							))}
						</div>
					</details>
				))}
			</div>
		</div>
	</section>

	<ImageText
		eyebrow="Apply"
		heading="Join the Balance"
		highlight="Performance team"
		reverse
		altBg
		image="/work-for-us/shop-interior.jpg"
		imageAlt="Inside the Balance Physio reception and shop"
	>
		<p>Don't see a role that fits? We're always on the lookout for exceptional new additions to our fantastic team, from consultant physiotherapists and osteopaths to soft tissue therapists, strength &amp; conditioning coaches, and admin. Send us your CV and a short note about what you're looking for. Include:</p>
		<ul>
			<li>Your full name</li>
			<li>Phone number</li>
			<li>Email address</li>
			<li>CV (PDF preferred)</li>
		</ul>
		<p>Email everything to <a href="mailto:admin@balancephysio.com" class="inline-link">admin@balancephysio.com</a> or call <strong>020 7627 2308</strong> to chat to us directly.</p>
	</ImageText>

	<BookingCTA />
</Layout>

<style>
	.roles-section { padding: 64px 0; }
	.roles-eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--cta);
		margin: 0 0 8px;
	}
	.roles-title { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0 0 12px; }
	.roles-title-accent { color: #e87722; }
	.roles-intro { margin: 0 0 32px; max-width: 60ch; line-height: 1.7; }
	.roles-list { display: flex; flex-direction: column; gap: 14px; }
	.role-item {
		border: 1px solid #e5e5e5;
		border-radius: 12px;
		background: #fff;
		overflow: hidden;
	}
	.role-item summary {
		cursor: pointer;
		padding: 20px 24px;
		display: flex;
		flex-direction: column;
		gap: 4px;
		list-style: none;
	}
	.role-item summary::-webkit-details-marker { display: none; }
	.role-item summary::after {
		content: '+';
		position: absolute;
		right: 24px;
		font-size: 1.6rem;
		line-height: 1;
		color: var(--cta);
		font-weight: 300;
	}
	.role-item[open] summary::after { content: '\2013'; }
	.role-item summary { position: relative; padding-right: 56px; }
	.role-name { font-size: 1.25rem; font-weight: 700; color: #1a1a1a; }
	.role-meta { font-size: 0.9rem; color: #666; }
	.role-body { padding: 0 24px 24px; }
	.role-body p { margin: 0 0 20px; line-height: 1.7; }
	.role-body ul { margin: 0 0 24px; padding-left: 22px; }
	.role-body li { margin-bottom: 10px; line-height: 1.7; }
	/* Extra space above the bold sub-headings (Requirements / What We Offer)
	   so each block reads as a distinct section. */
	.role-body p:has(> strong:only-child) { margin-top: 28px; }
	.role-body strong { color: #1a1a1a; }
	.role-body .inline-link {
		color: var(--cta);
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
</style>
