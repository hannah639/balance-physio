---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import BookingCTA from '../components/BookingCTA.astro';
import {pages} from '../lib/sanity/pageContent';

// Hero and SEO come from Sanity. The link list below stays in the template:
// it is navigation, and duplicating it into a page document would create a
// second source of navigation truth.
const doc = await pages.bySlug('thank-you');
---
<Layout
	title={doc?.seoTitle ?? "Thank you"}
	description={doc?.seoDescription ?? "Thanks for getting in touch with Balance Performance Physiotherapy."}
>
	<PageHero
		title={doc?.heroHeading ?? "you"}
		highlight={doc?.heroHighlight ?? "Thank"}
		subtitle={doc?.heroSubtitle ?? "Thank you for getting in touch, we'll get back to you as soon as possible!"}
		breadcrumb={doc?.breadcrumb ?? "Thank you"}
		hideCta
	/>

	<section class="thank-you-actions">
		<div class="thank-you-inner">
			<p>In the meantime, you might find what you're looking for here:</p>
			<div class="thank-you-links">
				<a href="/" class="btn-outline">Back to home</a>
				<a href="/service/physiotherapy/" class="btn-outline">Browse services</a>
				<a href="/faqs/" class="btn-outline">Read our FAQs</a>
			</div>
		</div>
	</section>

	<BookingCTA />
</Layout>

<style>
	.thank-you-actions { padding: 80px 24px; background: #ffffff; }
	.thank-you-inner { max-width: 720px; margin: 0 auto; text-align: center; }
	.thank-you-inner p { font-size: 18px; color: var(--text-muted); margin-bottom: 32px; }
	.thank-you-links { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
	.btn-outline {
		display: inline-block;
		padding: 14px 28px;
		border: 2px solid var(--primary);
		border-radius: 50px;
		color: var(--primary);
		font-weight: 600;
		text-decoration: none;
		transition: background .2s, color .2s;
	}
	.btn-outline:hover { background: var(--primary); color: #ffffff; }
</style>
