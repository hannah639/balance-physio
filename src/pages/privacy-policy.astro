---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { pages } from '../lib/sanity/pageContent';

// Hero and SEO come from Sanity -> Pages. Bespoke sections below stay in
// this file; see the completion notes for which pages are fully migrated.
// Clause content is CMS-driven — fail the build if the document is missing.
const doc = await pages.required('privacy-policy');
---
<Layout title={doc?.seoTitle ?? "Privacy Policy"} description={doc?.seoDescription ?? "Privacy Policy and Use of Cookies for Balance Performance Physiotherapy."}>
	<PageHero
		title={doc?.heroHeading ?? "Policy"}
		highlight={doc?.heroHighlight ?? "Privacy"}
		breadcrumb={doc?.breadcrumb ?? "Privacy Policy"}
		bgImage={doc?.heroImageUrl ?? undefined}
	/>
	<section class="rich-content">
		<div class="container">
			{/*
			  Clauses come from Sanity → Pages → Privacy Policy → Content sections.
			  Headings render as <h2> to preserve this page's existing hierarchy.
			*/}
			{doc.sections.map((section) => (
				<>
					{section.heading && <h2>{section.heading}</h2>}
					{section.body.map((block) => (
						block.kind === 'p'
							? <p>{block.text}</p>
							: <ul>{block.items.map((i) => <li>{i}</li>)}</ul>
					))}
				</>
			))}
		</div>
	</section>
</Layout>
