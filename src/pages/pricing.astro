---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import BookingCTA from '../components/BookingCTA.astro';
import { getPricing } from '../lib/sanity/pricing';
import { getGlobals } from '../lib/sanity/globals';

const pricing = await getPricing();
// Booking link is owned by Sanity → Booking Links (single source of truth).
const g = await getGlobals();
---
<Layout title={pricing.seoTitle} description={pricing.seoDescription}>
	<PageHero
		title={pricing.heroHeading}
		highlight={pricing.heroHighlight}
		subtitle={pricing.heroSubtitle}
		breadcrumb={pricing.breadcrumb}
		bgImage={pricing.heroImageUrl}
	/>

	{pricing.insuranceNotice && (
		<section class="pricing-insurance-notice">
			<div class="container">
				<div class="insurance-notice-box">
					<div class="insurance-notice-eyebrow"><span class="eyebrow-dot"></span>{pricing.insuranceNotice.eyebrow}</div>
					<h2>{pricing.insuranceNotice.heading} <span class="highlight">{pricing.insuranceNotice.headingHighlight}</span></h2>
					<p>{pricing.insuranceNotice.body}</p>
					<ul class="insurance-notice-channels">
						{pricing.insuranceNotice.phone && (
							<li><strong>Call:</strong> <a href={`tel:${pricing.insuranceNotice.phone.replace(/[^\d+]/g, '')}`} class="inline-link">{pricing.insuranceNotice.phone}</a></li>
						)}
						{pricing.insuranceNotice.whatsapp && pricing.insuranceNotice.whatsappUrl && (
							<li><strong>WhatsApp:</strong> <a href={pricing.insuranceNotice.whatsappUrl} target="_blank" rel="noopener" class="inline-link">{pricing.insuranceNotice.whatsapp}</a></li>
						)}
						{pricing.insuranceNotice.email && (
							<li><strong>Email:</strong> <a href={`mailto:${pricing.insuranceNotice.email}`} class="inline-link">{pricing.insuranceNotice.email}</a></li>
						)}
					</ul>
				</div>
			</div>
		</section>
	)}

	<section class="pricing-section">
		<div class="container">
			<div class="price-card-grid">
				{pricing.categories.map((cat) => (
					<div class="price-card" id={cat.anchor}>
						<h2 class="price-card-title">{cat.title}</h2>
						{cat.description && <p class="price-card-desc">{cat.description}</p>}
						{cat.sections.map((section) => (
							<>
								{section.heading && <h3 class="price-card-subheading">{section.heading}</h3>}
								<ul class="price-card-list">
									{section.items.map((item) => (
										<li class="price-card-row">
											<div class="price-card-row-main">
												<span class="price-card-name">
													{item.name}
													{item.badge && <span class="price-card-badge">{item.badge}</span>}
												</span>
												{item.note && <span class="price-card-note">{item.note}</span>}
											</div>
											<span class="price-card-price">{item.price}</span>
										</li>
									))}
								</ul>
							</>
						))}
						<a class="price-card-cta" href={g.bookingUrl} target="_blank" rel="noopener">{g.bookingLabel}</a>
					</div>
				))}
			</div>
		</div>
	</section>

	<BookingCTA />
</Layout>

<style>
	/* Insurance booking notice — sits above the pricing grid */
	.pricing-insurance-notice {
		padding: 40px 24px 0;
	}
	.pricing-insurance-notice .container {
		max-width: 1200px;
		margin: 0 auto;
	}
	.insurance-notice-box {
		background: #fdf4eb;
		border: 1px solid #f3d9b9;
		border-left: 4px solid #e87722;
		border-radius: 12px;
		padding: 28px 32px;
	}
	.insurance-notice-eyebrow {
		display: inline-flex; align-items: center; gap: 8px;
		background: rgba(232,119,34,0.12);
		border: 1px solid rgba(232,119,34,0.25);
		border-radius: 50px;
		padding: 5px 14px;
		font-size: 12px; font-weight: 700; color: #c45a0d;
		text-transform: uppercase; letter-spacing: 1.5px;
		margin-bottom: 14px;
	}
	.insurance-notice-eyebrow .eyebrow-dot {
		width: 7px; height: 7px; border-radius: 50%; background: #e87722;
	}
	.insurance-notice-box h2 {
		font-size: 26px; font-weight: 800; line-height: 1.2;
		margin: 0 0 12px; color: #1a1a1a;
	}
	.insurance-notice-box h2 .highlight { color: #e87722; }
	.insurance-notice-box p {
		font-size: 16px; line-height: 1.65; color: #4a4a4a;
		margin: 0 0 14px;
	}
	.insurance-notice-channels {
		list-style: none; margin: 0; padding: 0;
		display: flex; flex-wrap: wrap; gap: 8px 28px;
	}
	.insurance-notice-channels li {
		font-size: 15px; color: #1a1a1a;
	}
	.insurance-notice-channels .inline-link {
		color: #e87722; font-weight: 600; text-decoration: none;
	}
	.insurance-notice-channels .inline-link:hover { text-decoration: underline; }
	@media (max-width: 640px) {
		.pricing-insurance-notice { padding: 30px 18px 0; }
		.insurance-notice-box { padding: 22px 20px; }
		.insurance-notice-box h2 { font-size: 22px; }
		.insurance-notice-channels { flex-direction: column; gap: 6px; }
	}

	/* Optional CMS-driven elements. Each renders only when an editor fills the
	   field in, so the default look is unchanged from the pre-CMS page. */
	.price-card-desc {
		font-size: 14px;
		line-height: 1.6;
		color: #5a6b78;
		margin: -6px 0 16px;
	}
	.price-card-subheading {
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1.2px;
		color: #8595a1;
		margin: 18px 0 8px;
	}
	.price-card-subheading:first-of-type { margin-top: 0; }
	.price-card-badge {
		display: inline-block;
		margin-left: 8px;
		padding: 2px 8px;
		border-radius: 50px;
		background: rgba(232,119,34,0.12);
		border: 1px solid rgba(232,119,34,0.25);
		color: #c45a0d;
		font-size: 10px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.8px;
		vertical-align: middle;
	}

	.price-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 24px;
	}
	.price-card {
		background: #ffffff;
		border: 1px solid #e5e9ec;
		border-radius: 15px;
		padding: 32px 28px;
		display: flex;
		flex-direction: column;
		box-shadow: 0 1px 2px rgba(0,0,0,0.03);
		transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
		/* Offset for the fixed header so anchor scrolls don't hide the card title underneath it. */
		scroll-margin-top: 150px;
	}
	.price-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 14px 40px rgba(0,0,0,0.08);
		border-color: #e87722;
	}
	.price-card-title {
		font-size: 22px;
		font-weight: 800;
		letter-spacing: -0.5px;
		line-height: 1.25;
		margin: 0 0 20px;
		color: #1a1a1a;
	}
	.price-card-list {
		list-style: none;
		margin: 0 0 24px;
		padding: 0;
		flex: 1;
	}
	.price-card-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12px;
		padding: 14px 0;
		border-bottom: 1px solid #eef1f3;
	}
	.price-card-row:last-child { border-bottom: 0; }
	.price-card-row-main {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.price-card-name {
		font-size: 15px;
		font-weight: 600;
		color: #1a1a1a;
		line-height: 1.35;
	}
	.price-card-note {
		font-size: 12px;
		color: #6b7680;
		letter-spacing: 0.2px;
	}
	.price-card-price {
		font-size: 18px;
		font-weight: 800;
		color: #e87722;
		white-space: nowrap;
		flex-shrink: 0;
	}
	.price-card-cta {
		display: inline-block;
		margin-top: auto;
		text-align: center;
		padding: 14px 24px;
		border-radius: 50px;
		background: #3EBEDF;
		color: #ffffff;
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		transition: background .2s ease, transform .2s ease;
	}
	.price-card-cta:hover {
		background: #32a8c6;
		transform: translateY(-1px);
	}
	@media (max-width: 768px) {
		.price-card-grid {
			grid-template-columns: 1fr;
			gap: 20px;
		}
		.price-card { padding: 28px 22px; }
		.price-card-title { font-size: 20px; }
	}
</style>
