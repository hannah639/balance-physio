---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import BookingCTA from '../components/BookingCTA.astro';
import RichText from '../components/RichText.astro';
import { getGeneralFaqsRequired, answerToText } from '../lib/sanity/faqs';

// This page is owned entirely by Sanity → General FAQs: hero, SEO and the
// question list all come from that one document. There is no `page` document
// for /faqs/, so an editor has a single place to look.
const faqPage = await getGeneralFaqsRequired();
const { faqs, sectionTitle, introText } = faqPage;

// schema.org FAQPage — mirrors exactly the questions rendered below.
const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: { '@type': 'Answer', text: answerToText(item.answer) },
	})),
};

---
<Layout title={faqPage.seoTitle ?? faqPage.heroHeading} description={faqPage.seoDescription ?? undefined}>
	<PageHero
		title={faqPage.heroHeading}
		highlight={faqPage.heroHighlight ?? undefined}
		subtitle={faqPage.heroSubtitle ?? undefined}
		breadcrumb={faqPage.breadcrumb ?? undefined}
		bgImage={faqPage.heroImageUrl ?? undefined}
	/>

	<section class="faq-section">
		<div class="container">
			<div class="faq-list">
				{sectionTitle && <h2 class="faq-section-title">{sectionTitle}</h2>}
				{introText && <p class="faq-intro">{introText}</p>}
				{faqs.map((item) => (
					<details class="faq-item">
						<summary>{item.question}</summary>
						{/* Rendered as real markup — no set:html, so no raw CMS HTML. */}
						<div class="answer"><RichText blocks={item.answer} /></div>
					</details>
				))}
			</div>
		</div>
	</section>

	<script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

	<BookingCTA />
</Layout>

<style>
	.faq-section .answer p { margin: 0 0 14px; }
	.faq-section .answer p:last-child { margin-bottom: 0; }
	.faq-section .answer ul,
	.faq-section .answer ol { margin: 0 0 14px; padding-left: 22px; }
	.faq-section .answer li { margin-bottom: 6px; line-height: 1.7; }
	.faq-section .answer .inline-link {
		color: #e87722;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
	}
	.faq-section .answer .inline-link:hover { text-decoration-thickness: 2px; }
	/* Phone numbers and email addresses — make them stand out from body copy
	   with brand blue + bold so they're clearly clickable. */
	.faq-section .answer .inline-link[href^="tel:"],
	.faq-section .answer .inline-link[href^="mailto:"] {
		color: var(--cta);
		font-weight: 700;
	}
	.faq-section .answer strong { color: #1a1a1a; }
</style>
