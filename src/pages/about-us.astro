---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ImageText from '../components/ImageText.astro';
import BookingCTA from '../components/BookingCTA.astro';
import Testimonials from '../components/Testimonials.astro';
import { pages } from '../lib/sanity/pageContent';

// Hero and SEO come from Sanity -> Pages. Bespoke sections below stay in
// this file; see the completion notes for which pages are fully migrated.
// Section content is CMS-driven, so a missing document must fail the build
// rather than render an empty page.
const doc = await pages.required('about-us');
---
<Layout title={doc?.seoTitle ?? "About Us"} description={doc?.seoDescription ?? "Balance Performance Physiotherapy is London's largest rehabilitation centre with 27 professionals under one roof. Discover our approach to recovery and performance."}>
	<PageHero
		title={doc?.heroHeading ?? "About Us"}
		subtitle={doc?.heroSubtitle ?? "London's largest rehabilitation centre, 27 professionals under one roof, united by one mission."}
		breadcrumb={doc?.breadcrumb ?? "About Us"}
		bgImage={doc?.heroImageUrl ?? undefined}
	/>

	{doc.sections.map((section) => (
		<ImageText
			eyebrow={section.eyebrow ?? undefined}
			heading={section.heading ?? undefined}
			highlight={section.headingHighlight ?? undefined}
			reverse={section.imageOnRight}
			altBg={section.altBackground}
			image={section.image?.url ?? undefined}
			imageAlt={section.image?.alt ?? undefined}
			collage={section.gallery.length ? section.gallery.map((g) => ({ src: g.url, alt: g.alt })) : undefined}
		>
			{section.body.map((block) => (
				block.kind === 'p'
					? <p>{block.text}</p>
					: <ul>{block.items.map((i) => <li>{i}</li>)}</ul>
			))}
		</ImageText>
	))}

	<section class="stats-bar">
		<div class="container">
			<div class="stats-grid">
				<div class="stat">
					<div class="number">9/10</div>
					<div class="label">Patients improved in 3 months</div>
				</div>
				<div class="stat">
					<div class="number">35%</div>
					<div class="label">Decrease in pain in 6 weeks</div>
				</div>
				<div class="stat">
					<div class="number">40%</div>
					<div class="label">Increase in function in 6 weeks</div>
				</div>
			</div>
		</div>
	</section>

	<Testimonials />
	<BookingCTA />
</Layout>
