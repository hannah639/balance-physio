---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import BookingCTA from '../components/BookingCTA.astro';
import Picture from '../components/Picture.astro';
import { pages } from '../lib/sanity/pageContent';

// Hero and SEO come from Sanity -> Pages. Bespoke sections below stay in
// this file; see the completion notes for which pages are fully migrated.
// This page's body is CMS-driven, so a missing document must fail the
// build rather than render an empty page.
const doc = await pages.required('outcomes');

// Tabs and panels come from Sanity → Pages → Outcomes → Outcome panels.
// Astro keeps the tab-switching behaviour and layout.
const panels = doc.outcomePanels ?? [];
---
<Layout title={doc?.seoTitle ?? "Outcomes"} description={doc?.seoDescription ?? "Our Incredible Outcomes, patients typically discharged between 6 weeks and 3 months, with long-term results continuing beyond 12 months."}>
	<PageHero
		title={doc?.heroHeading ?? "Outcomes"}
		highlight={doc?.heroHighlight ?? "Our Incredible"}
		subtitle={doc?.heroSubtitle ?? "Our patients are typically discharged between 6 weeks and 3 months, but continue to see long-term results from 12 months and beyond."}
		breadcrumb={doc?.breadcrumb ?? "Outcomes"}
		bgImage={doc?.heroImageUrl ?? undefined}
	/>

	<section class="outcomes-section">
		<div class="container">
			<p class="outcomes-intro">We track pain and function at baseline, 6 weeks, 3 months, 6 months and 12 months across our five key specialisms.</p>

			<div class="outcomes-tabs" role="tablist">
				{panels.map((t, i) => (
					<button
						type="button"
						class={`outcomes-tab${i === 0 ? ' is-active' : ''}`}
						role="tab"
						aria-selected={i === 0 ? 'true' : 'false'}
						aria-controls={`panel-${t.panelId}`}
						id={`tab-${t.panelId}`}
						data-target={t.panelId}
					>
						{t.tabLabel}
					</button>
				))}
			</div>

			<div class="outcomes-panels">
				{panels.map((panel, i) => (
					<div
						class={`outcomes-panel${i === 0 ? ' is-active' : ''}`}
						id={`panel-${panel.panelId}`}
						role="tabpanel"
						aria-labelledby={`tab-${panel.panelId}`}
						hidden={i !== 0}
					>
						{panel.stats.length > 0 && (
							<div class="outcomes-stats">
								{panel.stats.map((stat) => (
									<div class="outcomes-stat">
										<div class="num">{stat.number}</div>
										<div class="label">{stat.label}</div>
									</div>
								))}
							</div>
						)}
						<div class="outcomes-body">
							{panel.heading && <h3>{panel.heading}</h3>}
							{panel.subheading && <h4>{panel.subheading}</h4>}
							{panel.body.map((block) => (
								block.kind === 'p'
									? <p>{block.text}</p>
									: <ul>{block.items.map((x) => <li>{x}</li>)}</ul>
							))}
							{panel.quotesLabel && <p class="outcomes-quotes-label"><em>{panel.quotesLabel}</em></p>}
							{panel.quotes.map((q) => <blockquote>{q}</blockquote>)}
						</div>
						{panel.chart && (
							<div class="outcomes-chart">
								<Picture src={panel.chart.url} alt={panel.chart.alt} loading="lazy" decoding="async" width="800" height="600" />
							</div>
						)}
					</div>
				))}
			</div>
		</div>
	</section>

	<BookingCTA />
</Layout>

<style>
	.outcomes-section {
		padding: 80px 0;
		background: linear-gradient(135deg, #f8f9fa 0%, #e8eef2 40%, #dce8ed 70%, #f0f4f6 100%);
	}
	.outcomes-intro {
		text-align: center;
		font-size: 18px;
		max-width: 720px;
		margin: 0 auto 48px;
		line-height: 1.7;
		color: #555;
	}

	/* Tab bar */
	.outcomes-tabs {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		margin-bottom: 40px;
		border-bottom: 1px solid rgba(0,0,0,0.08);
		padding-bottom: 12px;
	}
	.outcomes-tab {
		background: transparent;
		border: 1px solid transparent;
		color: #555;
		padding: 12px 22px;
		font-size: 15px;
		font-weight: 600;
		font-family: inherit;
		border-radius: 50px;
		cursor: pointer;
		transition: background .2s, color .2s, border-color .2s;
	}
	.outcomes-tab:hover {
		background: rgba(0,0,0,0.04);
		color: #1a1a1a;
	}
	.outcomes-tab.is-active {
		background: #2c4356;
		color: #fff;
		border-color: #2c4356;
	}

	/* Panels */
	.outcomes-panel {
		background: #fff;
		border-radius: 15px;
		padding: 40px 48px;
		box-shadow: 0 4px 20px rgba(0,0,0,0.05);
		animation: panelFadeIn .25s ease;
	}
	.outcomes-panel[hidden] { display: none; }
	@keyframes panelFadeIn {
		from { opacity: 0; transform: translateY(4px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.outcomes-panel h3 {
		font-size: 28px;
		font-weight: 800;
		letter-spacing: -0.5px;
		line-height: 1.2;
		margin: 0 0 6px;
		color: #e87722;
	}
	.outcomes-panel h4 {
		font-size: 20px;
		font-weight: 700;
		line-height: 1.3;
		margin: 0 0 28px;
		color: #1a1a1a;
	}
	.outcomes-chart {
		background: #fff;
		border: 1px solid #eef1f3;
		border-radius: 12px;
		padding: 16px;
		margin-bottom: 32px;
		text-align: center;
	}
	.outcomes-chart img {
		width: 100%;
		max-width: 780px;
		height: auto;
		display: inline-block;
	}
	.outcomes-body p {
		font-size: 16px;
		line-height: 1.7;
		color: #555;
		margin-bottom: 16px;
	}
	.outcomes-body strong { color: #1a1a1a; }
	.outcomes-quotes-label { margin-top: 28px !important; color: #1a1a1a !important; }
	.outcomes-body blockquote {
		font-style: italic;
		padding: 14px 22px;
		margin: 0 0 14px;
		border-left: 4px solid #e87722;
		color: #444;
		background: #faf7f5;
		border-radius: 0 8px 8px 0;
		font-size: 16px;
		line-height: 1.6;
	}

	/* Patient journey infographic */
	.outcomes-journey {
		margin-top: 40px;
		text-align: center;
	}
	.outcomes-journey img {
		max-width: 520px;
		width: 100%;
		height: auto;
		display: inline-block;
		border-radius: 12px;
		box-shadow: 0 10px 30px rgba(0,0,0,0.08);
	}

	/* General Outcomes stats */
	.outcomes-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
		margin-bottom: 40px;
	}
	.outcomes-stat {
		text-align: center;
		padding: 28px 20px;
		background: #f4f6f7;
		border-radius: 12px;
	}
	.outcomes-stat .num {
		font-size: 48px;
		font-weight: 800;
		color: #e87722;
		line-height: 1;
		margin-bottom: 10px;
	}
	.outcomes-stat .label {
		font-size: 14px;
		color: #555;
		font-weight: 600;
	}

	@media (max-width: 768px) {
		.outcomes-section { padding: 56px 0; }
		.outcomes-tab { padding: 10px 16px; font-size: 13px; }
		.outcomes-panel { padding: 28px 22px; }
		.outcomes-panel h3 { font-size: 22px; }
		.outcomes-panel h4 { font-size: 17px; }
		.outcomes-stats { grid-template-columns: 1fr; gap: 12px; }
		.outcomes-stat { padding: 20px; }
		.outcomes-stat .num { font-size: 36px; }
	}
</style>

<script is:inline>
	(function () {
		var tabs = document.querySelectorAll('.outcomes-tab');
		if (!tabs.length) return;
		function activate(id) {
			tabs.forEach(function (btn) {
				var isActive = btn.getAttribute('data-target') === id;
				btn.classList.toggle('is-active', isActive);
				btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
			});
			document.querySelectorAll('.outcomes-panel').forEach(function (panel) {
				var shouldShow = panel.id === 'panel-' + id;
				panel.classList.toggle('is-active', shouldShow);
				if (shouldShow) panel.removeAttribute('hidden');
				else panel.setAttribute('hidden', '');
			});
		}
		tabs.forEach(function (btn) {
			btn.addEventListener('click', function () {
				var target = btn.getAttribute('data-target');
				if (target) activate(target);
			});
		});
	})();
</script>
