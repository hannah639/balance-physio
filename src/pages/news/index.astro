---
/**
 * News grid, page one. Hero and SEO come from the Sanity `news` page
 * document, exactly as they did before; the posts themselves now come from
 * the blog documents.
 */
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import BlogGrid from '../../components/BlogGrid.astro';
import {pages} from '../../lib/sanity/pageContent';
import {getBlogPosts} from '../../lib/sanity/blog';
import {PAGE_SIZE} from '../../lib/sanity/blogPaging';

const doc = await pages.bySlug('news');
const all = await getBlogPosts();
const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const posts = all.slice(0, PAGE_SIZE);
---
<Layout
	title={doc?.seoTitle ?? "What have we been up to? | News & Events"}
	description={doc?.seoDescription ?? "News & Events from Balance Performance Physiotherapy in Clapham."}
>
	<PageHero
		title={doc?.heroHeading ?? "What have we been up to?"}
		breadcrumb={doc?.breadcrumb ?? "What have we been up to?"}
		bgImage={doc?.heroImageUrl ?? undefined}
	/>

	<BlogGrid posts={posts} page={1} totalPages={totalPages} />

	<BookingCTA />
</Layout>
