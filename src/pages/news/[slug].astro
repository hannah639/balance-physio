---
/**
 * Individual news post — /news/<slug>/.
 *
 * New route: the old site listed every article on one page with anchor links,
 * so no post had a URL of its own, a canonical, or structured data.
 *
 * getStaticPaths reads the same filtered list the grid uses, so unpublishing a
 * post in Sanity removes its page, its grid card, its sitemap entry and its
 * appearances in other posts' related lists in one action.
 */
import Layout from '../../layouts/Layout.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import Picture from '../../components/Picture.astro';
import RichText from '../../components/RichText.astro';
import BlogCard from '../../components/BlogCard.astro';
import {getBlogPosts, getBlogPost, getAdjacentPosts} from '../../lib/sanity/blog';
import {getGlobals} from '../../lib/sanity/globals';

export async function getStaticPaths() {
	const posts = await getBlogPosts();
	return posts.map((p) => ({params: {slug: p.slug}}));
}

const {slug} = Astro.params;
const post = await getBlogPost(slug!);

// getStaticPaths only emits published slugs, so this is a guard against a post
// being unpublished mid-build rather than an expected branch.
if (!post) return Astro.redirect('/news/', 302);

const {prev, next} = await getAdjacentPosts(post.slug);
const g = await getGlobals();
const url = `${g.siteUrl}${post.url}`;
const ogImage = post.ogImage ?? post.image;

const articleLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.title,
	...(post.excerpt && {description: post.excerpt}),
	mainEntityOfPage: {'@type': 'WebPage', '@id': url},
	url,
	...(post.image && {image: post.image.url}),
	...(post.publishedAt && {datePublished: post.publishedAt}),
	...(post.updatedAt && {dateModified: post.updatedAt}),
	...(post.authors.length && {
		author: post.authors.map((a) => ({
			'@type': 'Person',
			name: a.name,
			url: `${g.siteUrl}/team/${a.slug}/`,
		})),
	}),
	publisher: {
		'@type': 'Organization',
		name: g.siteName,
		...(g.business.logoUrl && {logo: {'@type': 'ImageObject', url: g.business.logoUrl}}),
	},
};

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{'@type': 'ListItem', position: 1, name: 'Home', item: `${g.siteUrl}/`},
		{'@type': 'ListItem', position: 2, name: 'News', item: `${g.siteUrl}/news/`},
		{'@type': 'ListItem', position: 3, name: post.title, item: url},
	],
};
---
<Layout
	title={post.seoTitle ?? post.title}
	description={post.seoDescription ?? post.excerpt ?? undefined}
>
	<article class="post">
		<div class="container post-inner">
			<nav class="post-breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a> <span aria-hidden="true">»</span>
				<a href="/news/">News</a> <span aria-hidden="true">»</span>
				<span aria-current="page">{post.title}</span>
			</nav>

			<header class="post-head">
				{post.categories.length > 0 && (
					<div class="post-tags">
						{post.categories.map((c) => <span class="post-tag">{c.title}</span>)}
					</div>
				)}
				<h1>{post.title}</h1>
				<div class="post-meta">
					{post.dateISO
						? <time datetime={post.dateISO}>{post.dateLabel}</time>
						: post.dateLabel && <span>{post.dateLabel}</span>}
					<span class="post-meta-sep" aria-hidden="true">·</span>
					<span>{post.readingMinutes} min read</span>
					{post.updatedLabel && (
						<>
							<span class="post-meta-sep" aria-hidden="true">·</span>
							<span>Updated {post.updatedLabel}</span>
						</>
					)}
				</div>
				{post.authors.length > 0 && (
					<div class="post-authors">
						{post.authors.map((a) => (
							<a class="post-author" href={`/team/${a.slug}/`}>
								{a.image && (
									<Picture src={a.image.url} alt={a.image.alt || a.name} loading="lazy" decoding="async" width="80" height="80" />
								)}
								<span>
									<strong>{a.name}</strong>
									{a.jobTitle && <em>{a.jobTitle}</em>}
								</span>
							</a>
						))}
					</div>
				)}
			</header>

			{post.image && (
				<div class="post-hero-image">
					<Picture
						src={post.image.url}
						alt={post.image.alt}
						loading="eager"
						decoding="async"
						width="1200"
						height="800"
					/>
				</div>
			)}

			<div class="post-body">
				<RichText blocks={post.body} />
			</div>

			{(prev || next) && (
				<nav class="post-nav" aria-label="More posts">
					{prev
						? <a class="post-nav-link" href={prev.url} rel="prev"><span>&larr; Previous</span><strong>{prev.title}</strong></a>
						: <span></span>}
					{next
						? <a class="post-nav-link post-nav-next" href={next.url} rel="next"><span>Next &rarr;</span><strong>{next.title}</strong></a>
						: <span></span>}
				</nav>
			)}
		</div>

		{post.related.length > 0 && (
			<section class="post-related">
				<div class="container">
					<div class="section-header"><h2>More from Balance</h2></div>
					<div class="post-related-grid">
						{post.related.map((r) => <BlogCard post={r} />)}
					</div>
				</div>
			</section>
		)}
	</article>

	<BookingCTA />

	<Fragment slot="head">
		<meta property="og:type" content="article" />
		{post.canonicalUrl && <link rel="canonical" href={post.canonicalUrl} />}
		{post.noIndex && <meta name="robots" content="noindex, nofollow" />}
		{ogImage && <meta property="og:image" content={ogImage.url} />}
		<script is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
	</Fragment>
</Layout>

<style>
	.post { background: linear-gradient(135deg, #f8f9fa 0%, #e8eef2 40%, #dce8ed 70%, #f0f4f6 100%); padding: 56px 0 0; }
	.post-inner { max-width: 820px; }
	.post-breadcrumb { font-size: 13px; color: var(--text-muted); margin-bottom: 28px; }
	.post-breadcrumb a { color: var(--text-muted); }
	.post-breadcrumb a:hover { color: var(--accent); }
	.post-head { margin-bottom: 28px; }
	.post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
	.post-tag { font-size: 12px; font-weight: 600; color: var(--primary); background: var(--white); border-radius: 50px; padding: 5px 14px; }
	.post-head h1 { font-size: 42px; font-weight: 800; line-height: 1.15; letter-spacing: -1px; margin-bottom: 16px; }
	.post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14px; color: var(--text-muted); }
	.post-meta-sep { opacity: .5; }
	.post-authors { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 20px; }
	.post-author { display: flex; align-items: center; gap: 10px; color: inherit; }
	.post-author :global(img) { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
	.post-author span { display: flex; flex-direction: column; line-height: 1.3; }
	.post-author strong { font-size: 15px; }
	.post-author em { font-size: 13px; font-style: normal; color: var(--text-muted); }
	.post-author:hover strong { color: var(--accent); }
	.post-hero-image { border-radius: var(--radius); overflow: hidden; margin-bottom: 32px; box-shadow: var(--card-shadow); }
	.post-hero-image :global(img) { width: 100%; height: auto; display: block; }
	.post-body { font-size: 17px; line-height: 1.8; color: var(--text-muted); }
	.post-body :global(p) { margin-bottom: 20px; }
	.post-body :global(h2) { font-size: 30px; font-weight: 800; color: var(--text); margin: 40px 0 16px; letter-spacing: -.5px; }
	.post-body :global(h3) { font-size: 22px; font-weight: 700; color: var(--text); margin: 32px 0 14px; }
	.post-body :global(ul), .post-body :global(ol) { margin: 0 0 20px 22px; }
	.post-body :global(li) { margin-bottom: 8px; }
	.post-body :global(blockquote) {
		margin: 28px 0; padding: 18px 24px; border-left: 4px solid var(--accent);
		background: var(--white); border-radius: 0 10px 10px 0; font-style: italic; color: var(--text);
	}
	.post-body :global(.inline-link) { color: var(--accent); font-weight: 600; text-decoration: underline; }
	.post-body :global(.rich-image) { margin: 28px 0; }
	.post-body :global(.rich-image img) { width: 100%; height: auto; border-radius: var(--radius); display: block; }
	.post-body :global(.rich-image figcaption) { font-size: 13px; color: var(--text-muted); margin-top: 8px; text-align: center; }

	.post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 48px 0 0; padding: 28px 0 56px; border-top: 1px solid var(--border); }
	.post-nav-link { display: flex; flex-direction: column; gap: 6px; color: inherit; }
	.post-nav-link span { font-size: 13px; color: var(--accent); font-weight: 600; }
	.post-nav-link strong { font-size: 16px; line-height: 1.4; }
	.post-nav-link:hover strong { color: var(--accent); }
	.post-nav-next { text-align: right; }

	.post-related { background: var(--white); padding: 64px 0 72px; }
	.post-related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: stretch; }

	@media (max-width: 900px) { .post-related-grid { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 768px) {
		.post-head h1 { font-size: 30px; letter-spacing: -.5px; }
		.post-nav { grid-template-columns: 1fr; }
		.post-nav-next { text-align: left; }
	}
	@media (max-width: 600px) { .post-related-grid { grid-template-columns: 1fr; } }
</style>
