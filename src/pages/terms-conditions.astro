---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { pages } from '../lib/sanity/pageContent';

// Hero and SEO come from Sanity -> Pages. Bespoke sections below stay in
// this file; see the completion notes for which pages are fully migrated.
// This page's body is CMS-driven, so a missing document must fail the
// build rather than render an empty page.
const doc = await pages.required('terms-conditions');
---
<Layout title={doc?.seoTitle ?? "Booking Terms & Conditions"} description={doc?.seoDescription ?? "Booking terms and conditions for Balance Performance Physiotherapy."}>
	<PageHero
		title={doc?.heroHeading ?? "&amp; Conditions"}
		highlight={doc?.heroHighlight ?? "Terms"}
		breadcrumb={doc?.breadcrumb ?? "Terms &amp; Conditions"}
		bgImage={doc?.heroImageUrl ?? undefined}
	/>
	<section class="rich-content">
		<div class="container">
			<h2>Balance Performance Physiotherapy Clinic Terms and Conditions</h2>

			{/*
			  The clauses come from Sanity → Pages → Terms & Conditions → Content
			  sections. Headings render as <h3> to keep this page's existing
			  hierarchy (one <h2> for the document, <h3> per clause).
			*/}
			{doc.sections.map((section) => (
				<>
					{section.heading && <h3>{section.heading}</h3>}
					{section.body.map((block) => (
						block.kind === 'p'
							? <p>{block.text}</p>
							: <ul>{block.items.map((i) => <li>{i}</li>)}</ul>
					))}
				</>
			))}
		</div>
	</section>
</Layout>
