---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import Picture from '../../components/Picture.astro';
import { getTeam, initials, gradientFor } from '../../lib/sanity/team';
import { resolveSpecialisms } from '../../lib/sanity/specialisms';

export async function getStaticPaths() {
	// One route per published team member in Sanity. Unpublished members simply
	// stop generating a page — no broken route, no build failure.
	const team = await getTeam();
	return team.map((member) => ({
		params: { slug: member.slug },
		props: { member },
	}));
}

const { member } = Astro.props;
const avatarGradient = gradientFor(member.name);
// Specialisms are free text in the CMS; resolveSpecialisms() links each one to
// the condition or service page that covers it, and leaves it as plain text
// when no page does. See src/lib/sanity/specialisms.ts.
const specialisms = resolveSpecialisms(member.specialistAreas);
---
<Layout
	title={member.seoTitle ?? member.name}
	description={member.seoDescription ?? `${member.name}, ${member.jobTitle} at Balance Performance Physiotherapy in Clapham.`}
>
	<PageHero
		title={member.jobTitle}
		highlight={member.name}
		breadcrumb={member.name}
	/>

	<section class="bio-section">
		<div class="container">
			<div class="bio-grid">
				{member.photo?.url ? (
					<div class="bio-photo bio-photo--img">
						<Picture src={member.photo.url} alt={member.name} decoding="async" width="500" height="600" />
					</div>
				) : (
					<div class="bio-photo" style={`background: ${avatarGradient};`}>
						<span class="bio-initials">{initials(member.name)}</span>
					</div>
				)}
				<div class="bio-body">
					<div class="eyebrow"><span class="eyebrow-dot"></span>About {member.name.split(' ')[0]}</div>
					<h2>{member.name}</h2>
					<p class="bio-role">{member.jobTitle}</p>
					{member.qualifications.length > 0 && (
						<ul class="bio-creds">
							{member.qualifications.map((q) => <li>{q}</li>)}
						</ul>
					)}
					{specialisms.length > 0 && (
						<div class="bio-specialisms">
							<h3 class="bio-specialisms-title">Specialisms</h3>
							<ul class="bio-specialisms-list">
								{specialisms.map((s) => (
									<li>{s.href ? <a href={s.href}>{s.label}</a> : <span>{s.label}</span>}</li>
								))}
							</ul>
						</div>
					)}
					{member.bio ? (
						member.bio.map((p) => <p>{p}</p>)
					) : (
						<>
							<p>{member.name} is part of the Balance Performance Physiotherapy team in Clapham. A full bio is coming soon, in the meantime, you can book a session directly or call our reception team for more information.</p>
							<p>Our clinicians work collaboratively across specialisms, so if you're not sure who to book with, our admin team will match you with the right practitioner for your needs.</p>
						</>
					)}
					<p><a href="/meet-the-team/" class="inline-link">&laquo; Back to the team</a></p>
				</div>
			</div>
		</div>
	</section>

	<BookingCTA />
</Layout>

<style>
	.bio-section { padding: 80px 0; background: #ffffff; }
	.bio-grid { display: grid; grid-template-columns: 320px 1fr; gap: 64px; align-items: start; max-width: 1000px; margin: 0 auto; }
	.bio-photo { width: 320px; height: 400px; border-radius: 15px; display: flex; align-items: center; justify-content: center; box-shadow: 0 20px 60px rgba(0,0,0,0.12); overflow: hidden; }
	/* Sticky photo column. The bio text is normally far taller than the 400px
	   portrait, so the photo holds its place while the prose scrolls past it,
	   then releases at the bottom of the section.
	   - top: 100px matches .image-text-media and .image-toggle-media in
	     Layout.astro, and clears the fixed header.
	   - align-self: start is what gives sticky somewhere to travel; a
	     stretched grid item fills its row and cannot move. .bio-grid already
	     sets align-items: start, this states it on the item that depends on it.
	   - It stays inside .bio-section because a sticky grid item is bounded by
	     its grid area, whose height is the bio column next to it.
	   No ancestor sets overflow, which would disable this with no error. */
	.bio-photo--img { padding: 0; position: sticky; top: 100px; align-self: start; }
	.bio-photo--img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		display: block;
	}
	.bio-initials { color: #ffffff; font-size: 96px; font-weight: 800; letter-spacing: -3px; font-family: 'Inter', sans-serif; }
	.bio-body .eyebrow { display: inline-flex; align-items: center; gap: 8px; background: rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.1); border-radius: 50px; padding: 6px 16px; font-size: 13px; font-weight: 600; color: #1a1a1a; margin-bottom: 20px; }
	.bio-body .eyebrow-dot { width: 8px; height: 8px; border-radius: 50%; background: #e87722; }
	.bio-body h2 { font-size: 36px; font-weight: 800; letter-spacing: -1px; line-height: 1.15; margin-bottom: 8px; }
	.bio-role { font-size: 14px; color: #e87722; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 24px; }
	.bio-body p { font-size: 17px; line-height: 1.8; color: #555555; margin-bottom: 18px; }

	/* Credentials — the CMS holds one entry per line ("Ph.D, MCSP, SRP",
	   "30+ Years of Experience"), so this is a list, not a paragraph. */
	.bio-creds { list-style: none; margin: -8px 0 24px; }
	.bio-creds li { font-size: 15px; font-weight: 600; color: var(--text); line-height: 1.5; }
	.bio-creds li + li { margin-top: 2px; }
	.bio-creds li:first-child { letter-spacing: 0.3px; }

	/* Specialisms — pills, each linking to the page that covers it. */
	.bio-specialisms { margin: 0 0 28px; padding: 20px 22px; background: var(--primary-bg); border: 1px solid var(--border); border-radius: var(--radius); }
	.bio-specialisms-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--primary); margin-bottom: 14px; }
	.bio-specialisms-list { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
	.bio-specialisms-list li { display: flex; }
	.bio-specialisms-list a,
	.bio-specialisms-list span { display: inline-block; padding: 8px 16px; border-radius: 50px; font-size: 15px; font-weight: 600; line-height: 1.3; background: var(--white); border: 1px solid var(--border); }
	.bio-specialisms-list a { color: var(--primary); text-decoration: none; transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease; }
	.bio-specialisms-list a:hover,
	.bio-specialisms-list a:focus-visible { background: var(--accent); border-color: var(--accent); color: var(--white); }
	/* No page covers this specialism — plain text, deliberately not a link. */
	.bio-specialisms-list span { color: var(--text-muted); }
	.bio-body .inline-link { color: #3EBEDF; font-weight: 600; }
	.bio-body .inline-link:hover { text-decoration: underline; }
	@media (max-width: 900px) {
		.bio-section { padding: 60px 0; }
		.bio-grid { grid-template-columns: 1fr; gap: 32px; }
		/* On mobile, keep the photo's natural 3:4 portrait ratio so faces
		   aren't cropped off at the top or bottom by the desktop fixed
		   height of 280px. */
		.bio-photo { width: 100%; max-width: 320px; height: auto; aspect-ratio: 3/4; margin: 0 auto; }
		/* One column below 900px: the photo sits above the text, so there is
		   nothing to scroll past and sticking it would only detach it from the
		   bio it belongs to. Same treatment as .image-text-media. */
		.bio-photo--img { position: static; top: auto; }
		.bio-initials { font-size: 72px; }
		.bio-body h2 { font-size: 28px; }
		.bio-specialisms { padding: 18px; }
	}
</style>
