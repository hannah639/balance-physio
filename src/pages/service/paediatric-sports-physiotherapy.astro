---
import ServicePage from '../../components/ServicePage.astro';
import { services } from '../../lib/sanity/pageContent';

const doc = await services.required('paediatric-sports-physiotherapy');
---
<ServicePage
	title={doc.heroHeading}
	highlight={doc.heroHighlight ?? undefined}
	heroSubtitle={doc.heroSubtitle ?? undefined}
	breadcrumb={doc.breadcrumb ?? undefined}
	seoTitle={doc.seoTitle ?? "Youth Physiotherapy in Clapham"}
	seoDescription={doc.seoDescription ?? "Consultant youth physiotherapy in Clapham, London. Led by Dan Elias, specialist in sports injuries, developmental movement and return-to-play for children and adolescents."}
	marqueeImages={doc.photoGallery.map((p) => ({ src: p.url, alt: p.alt }))}
	sections={doc.sections}
	faqs={doc.faqs.map((f) => ({ q: f.question, a: f.answer }))}
>
</ServicePage>
