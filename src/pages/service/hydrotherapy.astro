---
import Layout from '../../layouts/Layout.astro';
import { getGlobals } from '../../lib/sanity/globals';
import PageHero from '../../components/PageHero.astro';
import ImageText from '../../components/ImageText.astro';
import PhotoMarquee from '../../components/PhotoMarquee.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import RichText from '../../components/RichText.astro';
import { services } from '../../lib/sanity/pageContent';

const doc = await services.required('hydrotherapy');

const photos = doc.photoGallery.map((p) => ({ src: p.url, alt: p.alt }));

const bookingUrl = (await getGlobals()).bookingUrl;

const faqs = doc.faqs.map((f) => ({ q: f.question, a: f.answer }));

const glossary = [
	{ term: 'Buoyancy', definition: 'The upward force exerted by a fluid that opposes the weight of an immersed object.' },
	{ term: 'Hydrostatic Pressure', definition: 'The pressure exerted by the water on the body, which can help reduce swelling and improve circulation.' },
	{ term: 'Aquatic Therapy', definition: 'Another term for hydrotherapy, focusing on exercises performed in water for rehabilitation.' },
	{ term: 'Resistance', definition: 'The physical property of water that provides a counter-force to movement, used for strengthening.' },
];
---
<Layout
	title={doc.seoTitle ?? "Hydrotherapy Clapham | Aquatic Physiotherapy & Rehab Therapy"}
	description={doc.seoDescription ?? "Hydrotherapy in Clapham to support rehabilitation, reduce pain, and improve movement. Water-based physiotherapy for recovery and long-term function."}
>
	<PageHero
		title={doc.heroHeading}
		highlight={doc.heroHighlight ?? undefined}
		breadcrumb={doc.breadcrumb ?? undefined}
	/>

	<PhotoMarquee images={photos} heightPx={140} speedSeconds={45} />

	<div class="service-intro">
	{doc.sections[0] && (
	<ImageText
		eyebrow={doc.sections[0].eyebrow ?? undefined}
		heading={doc.sections[0].heading ?? undefined}
		highlight={doc.sections[0].headingHighlight ?? undefined}
		reverse={doc.sections[0].imageOnRight}
		altBg={doc.sections[0].altBackground}
		youtubeId="kJ9Ny2lFDzk"
		autoplay
	>
		<RichText blocks={doc.sections[0].blocks} />
		{doc.sections[0].ctaLabel && (
			<p><a
				href={doc.sections[0].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[0].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[0].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[0].ctaLabel}</a></p>
		)}
	</ImageText>
	)}
	</div>

	{doc.sections[1] && (
	<ImageText
		eyebrow={doc.sections[1].eyebrow ?? undefined}
		heading={doc.sections[1].heading ?? undefined}
		highlight={doc.sections[1].headingHighlight ?? undefined}
		reverse={doc.sections[1].imageOnRight}
		altBg={doc.sections[1].altBackground}
		image={doc.sections[1].image?.url ?? undefined}
		imageAlt={doc.sections[1].image?.alt ?? ''}
	>
		<RichText blocks={doc.sections[1].blocks} />
		{doc.sections[1].ctaLabel && (
			<p><a
				href={doc.sections[1].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[1].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[1].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[1].ctaLabel}</a></p>
		)}
	</ImageText>
	)}

	{doc.sections[2] && (
	<ImageText
		eyebrow={doc.sections[2].eyebrow ?? undefined}
		heading={doc.sections[2].heading ?? undefined}
		highlight={doc.sections[2].headingHighlight ?? undefined}
		reverse={doc.sections[2].imageOnRight}
		altBg={doc.sections[2].altBackground}
		image={doc.sections[2].image?.url ?? undefined}
		imageAlt={doc.sections[2].image?.alt ?? ''}
	>
		<RichText blocks={doc.sections[2].blocks} />
		{doc.sections[2].ctaLabel && (
			<p><a
				href={doc.sections[2].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[2].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[2].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[2].ctaLabel}</a></p>
		)}
	</ImageText>
	)}

	{doc.sections[3] && (
	<ImageText
		eyebrow={doc.sections[3].eyebrow ?? undefined}
		heading={doc.sections[3].heading ?? undefined}
		highlight={doc.sections[3].headingHighlight ?? undefined}
		reverse={doc.sections[3].imageOnRight}
		altBg={doc.sections[3].altBackground}
		image={doc.sections[3].image?.url ?? undefined}
		imageAlt={doc.sections[3].image?.alt ?? ''}
	>
		<RichText blocks={doc.sections[3].blocks} />
		{doc.sections[3].ctaLabel && (
			<p><a
				href={doc.sections[3].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[3].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[3].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[3].ctaLabel}</a></p>
		)}
	</ImageText>
	)}

	{doc.sections[4] && (
	<ImageText
		eyebrow={doc.sections[4].eyebrow ?? undefined}
		heading={doc.sections[4].heading ?? undefined}
		highlight={doc.sections[4].headingHighlight ?? undefined}
		reverse={doc.sections[4].imageOnRight}
		altBg={doc.sections[4].altBackground}
		image={doc.sections[4].image?.url ?? undefined}
		imageAlt={doc.sections[4].image?.alt ?? ''}
	>
		<RichText blocks={doc.sections[4].blocks} />
		{doc.sections[4].ctaLabel && (
			<p><a
				href={doc.sections[4].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[4].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[4].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[4].ctaLabel}</a></p>
		)}
	</ImageText>
	)}

	{doc.sections[5] && (
	<ImageText
		eyebrow={doc.sections[5].eyebrow ?? undefined}
		heading={doc.sections[5].heading ?? undefined}
		highlight={doc.sections[5].headingHighlight ?? undefined}
		reverse={doc.sections[5].imageOnRight}
		altBg={doc.sections[5].altBackground}
		image={doc.sections[5].image?.url ?? undefined}
		imageAlt={doc.sections[5].image?.alt ?? ''}
	>
		<RichText blocks={doc.sections[5].blocks} />
		{doc.sections[5].ctaLabel && (
			<p><a
				href={doc.sections[5].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[5].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[5].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[5].ctaLabel}</a></p>
		)}
	</ImageText>
	)}

	{doc.sections[6] && (
	<ImageText
		eyebrow={doc.sections[6].eyebrow ?? undefined}
		heading={doc.sections[6].heading ?? undefined}
		highlight={doc.sections[6].headingHighlight ?? undefined}
		reverse={doc.sections[6].imageOnRight}
		altBg={doc.sections[6].altBackground}
		mapEmbedUrl="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2593.1190346254107!2d-0.1486525!3d51.45289760000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x487605b630c3c9d3%3A0x9ad3c77ad81840c6!2sAudley%20Nightingale%20Place!5e1!3m2!1sen!2suk!4v1776940633643!5m2!1sen!2suk"
	>
		<RichText blocks={doc.sections[6].blocks} />
		{doc.sections[6].ctaLabel && (
			<p><a
				href={doc.sections[6].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[6].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[6].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[6].ctaLabel}</a></p>
		)}
	</ImageText>
	)}

	{doc.sections[7] && (
	<ImageText
		eyebrow={doc.sections[7].eyebrow ?? undefined}
		heading={doc.sections[7].heading ?? undefined}
		highlight={doc.sections[7].headingHighlight ?? undefined}
		reverse={doc.sections[7].imageOnRight}
		altBg={doc.sections[7].altBackground}
		image={doc.sections[7].image?.url ?? undefined}
		imageAlt={doc.sections[7].image?.alt ?? ''}
	>
		<RichText blocks={doc.sections[7].blocks} />
		{doc.sections[7].ctaLabel && (
			<p><a
				href={doc.sections[7].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[7].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[7].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[7].ctaLabel}</a></p>
		)}
	</ImageText>
	)}

	<section class="faq-section faq-section--alt">
		<div class="container">
			<div class="section-header"><h2>Frequently Asked Questions</h2></div>
			<div class="faq-list">
				{faqs.map((item) => (
					<details class="faq-item">
						<summary>{item.q}</summary>
						<div class="answer"><RichText blocks={item.a} /></div>
					</details>
				))}
				<details class="faq-item">
					<summary>Glossary of terms</summary>
					<div class="answer">
						<dl class="glossary-list">
							{glossary.map((g) => (
								<>
									<dt>{g.term}</dt>
									<dd>{g.definition}</dd>
								</>
							))}
						</dl>
					</div>
				</details>
			</div>
		</div>
	</section>

	<BookingCTA />
</Layout>

<style>
	.glossary-list { margin: 0; padding: 0; }
	.glossary-list dt { font-weight: 700; color: var(--text); margin-top: 14px; font-size: 16px; }
	.glossary-list dt:first-child { margin-top: 0; }
	.glossary-list dd { margin: 4px 0 0; padding: 0; color: var(--text-muted); line-height: 1.6; }
</style>
