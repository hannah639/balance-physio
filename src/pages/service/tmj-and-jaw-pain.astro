---
import ServicePage from '../../components/ServicePage.astro';
import { services } from '../../lib/sanity/pageContent';

const doc = await services.required('tmj-and-jaw-pain');
---
<ServicePage
	title={doc.heroHeading}
	highlight={doc.heroHighlight ?? undefined}
	heroSubtitle={doc.heroSubtitle ?? undefined}
	breadcrumb={doc.breadcrumb ?? undefined}
	seoTitle={doc.seoTitle ?? "TMJ & Jaw Pain Treatment Clapham | Jaw Physiotherapy London"}
	seoDescription={doc.seoDescription ?? "TMJ and jaw pain treatment in Clapham to reduce pain, improve movement, and restore function. Expert physiotherapy for jaw, neck, and related symptoms."}
	marqueeImages={doc.photoGallery.map((p) => ({ src: p.url, alt: p.alt }))}
	sections={doc.sections}
	faqs={doc.faqs.map((f) => ({ q: f.question, a: f.answer }))}
>
