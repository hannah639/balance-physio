---
import Layout from '../../layouts/Layout.astro';
import { getGlobals } from '../../lib/sanity/globals';
import PageHero from '../../components/PageHero.astro';
import ImageText from '../../components/ImageText.astro';
import PhotoMarquee from '../../components/PhotoMarquee.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import Picture from '../../components/Picture.astro';
import RichText from '../../components/RichText.astro';
import { services } from '../../lib/sanity/pageContent';

const doc = await services.required('strength-conditioning');

const photos = doc.photoGallery.map((p) => ({ src: p.url, alt: p.alt }));

const bookingUrl = (await getGlobals()).bookingUrl;

const faqs = doc.faqs.map((f) => ({ q: f.question, a: f.answer }));
---
<Layout
	title={doc.seoTitle ?? "Strength & Conditioning Clapham | Performance & Rehab Training"}
	description={doc.seoDescription ?? "Strength and conditioning in Clapham to build strength, improve performance, and support recovery. Personalised training for long-term health and resilience."}
>
	<PageHero
		title={doc.heroHeading}
		highlight={doc.heroHighlight ?? undefined}
		breadcrumb={doc.breadcrumb ?? undefined}
	/>

	<PhotoMarquee images={photos} heightPx={140} speedSeconds={45} />

	<div class="service-intro">
	{doc.sections[0] && (
	<ImageText
		eyebrow={doc.sections[0].eyebrow ?? undefined}
		heading={doc.sections[0].heading ?? undefined}
		highlight={doc.sections[0].headingHighlight ?? undefined}
		reverse={doc.sections[0].imageOnRight}
		altBg={doc.sections[0].altBackground}
		youtubeId="iVHv-B6Ywds"
		autoplay
	>
		<RichText blocks={doc.sections[0].blocks} />
		{doc.sections[0].ctaLabel && (
			<p><a
				href={doc.sections[0].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[0].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[0].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[0].ctaLabel}</a></p>
		)}
	</ImageText>
	)}
	</div>

	{doc.sections[1] && (
	<ImageText
		eyebrow={doc.sections[1].eyebrow ?? undefined}
		heading={doc.sections[1].heading ?? undefined}
		highlight={doc.sections[1].headingHighlight ?? undefined}
		reverse={doc.sections[1].imageOnRight}
		altBg={doc.sections[1].altBackground}
		image={doc.sections[1].image?.url ?? undefined}
		imageAlt={doc.sections[1].image?.alt ?? ''}
	>
		<RichText blocks={doc.sections[1].blocks} />
		{doc.sections[1].ctaLabel && (
			<p><a
				href={doc.sections[1].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[1].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[1].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[1].ctaLabel}</a></p>
		)}
	</ImageText>
	)}

	{doc.sections[2] && (
	<ImageText
		eyebrow={doc.sections[2].eyebrow ?? undefined}
		heading={doc.sections[2].heading ?? undefined}
		highlight={doc.sections[2].headingHighlight ?? undefined}
		reverse={doc.sections[2].imageOnRight}
		altBg={doc.sections[2].altBackground}
		image={doc.sections[2].image?.url ?? undefined}
		imageAlt={doc.sections[2].image?.alt ?? ''}
	>
		<RichText blocks={doc.sections[2].blocks} />
		{doc.sections[2].ctaLabel && (
			<p><a
				href={doc.sections[2].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[2].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[2].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[2].ctaLabel}</a></p>
		)}
	</ImageText>
	)}

	{doc.sections[3] && (
	<ImageText
		eyebrow={doc.sections[3].eyebrow ?? undefined}
		heading={doc.sections[3].heading ?? undefined}
		highlight={doc.sections[3].headingHighlight ?? undefined}
		reverse={doc.sections[3].imageOnRight}
		altBg={doc.sections[3].altBackground}
		image={doc.sections[3].image?.url ?? undefined}
		imageAlt={doc.sections[3].image?.alt ?? ''}
	>
		<RichText blocks={doc.sections[3].blocks} />
		{doc.sections[3].ctaLabel && (
			<p><a
				href={doc.sections[3].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[3].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[3].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[3].ctaLabel}</a></p>
		)}
	</ImageText>
	)}

	{doc.sections[4] && (
	<ImageText
		eyebrow={doc.sections[4].eyebrow ?? undefined}
		heading={doc.sections[4].heading ?? undefined}
		highlight={doc.sections[4].headingHighlight ?? undefined}
		reverse={doc.sections[4].imageOnRight}
		altBg={doc.sections[4].altBackground}
		image={doc.sections[4].image?.url ?? undefined}
		imageAlt={doc.sections[4].image?.alt ?? ''}
	>
		<RichText blocks={doc.sections[4].blocks} />
		{doc.sections[4].ctaLabel && (
			<p><a
				href={doc.sections[4].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[4].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[4].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[4].ctaLabel}</a></p>
		)}
	</ImageText>
	)}

	{doc.sections[5] && (
	<ImageText
		eyebrow={doc.sections[5].eyebrow ?? undefined}
		heading={doc.sections[5].heading ?? undefined}
		highlight={doc.sections[5].headingHighlight ?? undefined}
		reverse={doc.sections[5].imageOnRight}
		altBg={doc.sections[5].altBackground}
		image={doc.sections[5].image?.url ?? undefined}
		imageAlt={doc.sections[5].image?.alt ?? ''}
	>
		<RichText blocks={doc.sections[5].blocks} />
		{doc.sections[5].ctaLabel && (
			<p><a
				href={doc.sections[5].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[5].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[5].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[5].ctaLabel}</a></p>
		)}
	</ImageText>
	)}

	{doc.sections[6] && (
	<ImageText
		eyebrow={doc.sections[6].eyebrow ?? undefined}
		heading={doc.sections[6].heading ?? undefined}
		highlight={doc.sections[6].headingHighlight ?? undefined}
		reverse={doc.sections[6].imageOnRight}
		altBg={doc.sections[6].altBackground}
		image={doc.sections[6].image?.url ?? undefined}
		imageAlt={doc.sections[6].image?.alt ?? ''}
	>
		<RichText blocks={doc.sections[6].blocks} />
		{doc.sections[6].ctaLabel && (
			<p><a
				href={doc.sections[6].ctaUrl ?? bookingUrl}
				class="btn-primary"
				target={doc.sections[6].ctaUrl ? undefined : '_blank'}
				rel={doc.sections[6].ctaUrl ? undefined : 'noopener'}
			>{doc.sections[6].ctaLabel}</a></p>
		)}
	</ImageText>
	)}

	<section class="sc-promos">
		<div class="container">
			<div class="sc-offers-banner">
				<div class="sc-offers-content">
					<div class="hero-badge"><span class="dot"></span> Our offers</div>
					<h2>New to strength &amp; conditioning?</h2>
					<p class="sc-offers-intro">Take advantage of one of our introductory offers to get started with Alex and the team:</p>
					<ul class="sc-offers-list">
						<li>
							<span class="sc-offer-tag">Free</span>
							<span>A <strong>free 45-minute taster session</strong> for Personal Training / Strength &amp; Conditioning with Alex, <em>or</em> your <strong>first Weight Training Class free</strong> with Alex</span>
						</li>
						<li>
							<span class="sc-offer-tag sc-offer-tag--value">10 → 12</span>
							<span>Pay for <strong>10 sessions and receive 12</strong> — available in 45 and 60 minutes</span>
						</li>
					</ul>
					<p class="sc-offers-note">Please note the two free options are either/or — you're welcome to one of them, not both. These offers can't be booked online, so just get in touch and we'll set you up.</p>
					<div class="sc-offers-actions">
						<a href="/contact-us/" class="btn-book">Contact us</a>
						<a href="tel:02076272308" class="btn-outline-white">020 7627 2308</a>
					</div>
				</div>
				<div class="sc-offers-collage" aria-hidden="true">
					<div class="sc-collage-cell"><Picture src="/strength-conditioning/slider-sam-and-alex-1.webp" alt="" loading="lazy" decoding="async" width="600" height="700" /></div>
					<div class="sc-collage-cell"><Picture src="/strength-conditioning/slider-woman-barbell.jpg" alt="" loading="lazy" decoding="async" width="600" height="400" /></div>
					<div class="sc-collage-cell"><Picture src="/strength-conditioning/slider-IMG_0457.jpeg" alt="" loading="lazy" decoding="async" width="600" height="342" /></div>
					<div class="sc-collage-cell"><Picture src="/strength-conditioning/slider-multiracial-athletes.jpg" alt="" loading="lazy" decoding="async" width="600" height="400" /></div>
				</div>
			</div>
		</div>
	</section>

	<section class="faq-section faq-section--alt">
		<div class="container">
			<div class="section-header"><h2>Frequently Asked Questions</h2></div>
			<div class="faq-list">
				{faqs.map((item) => (
					<details class="faq-item">
						<summary>{item.q}</summary>
						<div class="answer"><RichText blocks={item.a} /></div>
					</details>
				))}
			</div>
		</div>
	</section>

	<BookingCTA />
</Layout>

<style>
	/* Strength & Conditioning introductory offers banner */
	.sc-promos { padding: 80px 0; background: #f6f8f9; }
	.sc-offers-banner {
		position: relative;
		max-width: 1120px;
		margin: 0 auto;
		background: linear-gradient(135deg, #1f3346 0%, #2c4a63 100%);
		border-radius: 20px;
		padding: 56px;
		color: #ffffff;
		box-shadow: 0 24px 60px rgba(20,40,60,0.28);
		overflow: hidden;
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: 48px;
		align-items: center;
	}
	/* Subtle orange glow accent, top-right, echoing the brand */
	.sc-offers-banner::after {
		content: '';
		position: absolute;
		top: -80px; right: -80px;
		width: 260px; height: 260px;
		background: radial-gradient(circle, rgba(232,119,34,0.28) 0%, rgba(232,119,34,0) 70%);
		pointer-events: none;
	}
	.sc-offers-content { position: relative; z-index: 1; }

	/* 2×2 image collage, sourced from the S&C slider photos */
	.sc-offers-collage {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-auto-rows: 1fr;
		gap: 12px;
		aspect-ratio: 1 / 1;
	}
	.sc-collage-cell {
		position: relative;
		overflow: hidden;
		border-radius: 12px;
		background: rgba(255,255,255,0.06);
		box-shadow: 0 10px 26px rgba(0,0,0,0.22);
	}
	.sc-collage-cell :global(picture),
	.sc-collage-cell :global(img) {
		position: absolute; inset: 0;
		width: 100%; height: 100%;
		object-fit: cover;
		display: block;
	}
	/* Gentle offset so the collage feels dynamic rather than a flat grid */
	.sc-collage-cell:nth-child(1) { transform: translateY(-10px); }
	.sc-collage-cell:nth-child(4) { transform: translateY(10px); }
	.sc-offers-banner .hero-badge {
		display: inline-flex; align-items: center; gap: 8px;
		background: rgba(255,255,255,0.1);
		border: 1px solid rgba(255,255,255,0.2);
		border-radius: 50px;
		padding: 6px 16px;
		font-size: 13px; font-weight: 500;
		margin-bottom: 22px;
		color: rgba(255,255,255,0.9);
	}
	.sc-offers-banner .hero-badge .dot {
		width: 8px; height: 8px; border-radius: 50%; background: #e87722;
	}
	.sc-offers-banner h2 {
		font-size: 34px; font-weight: 800; line-height: 1.15;
		letter-spacing: -0.8px; margin: 0 0 14px; color: #ffffff;
	}
	.sc-offers-intro {
		font-size: 17px; line-height: 1.6;
		color: rgba(255,255,255,0.88); margin: 0 0 28px;
	}
	.sc-offers-list { list-style: none; margin: 0 0 26px; padding: 0; display: flex; flex-direction: column; gap: 18px; }
	.sc-offers-list li {
		display: flex; align-items: flex-start; gap: 16px;
		font-size: 16px; line-height: 1.6; color: rgba(255,255,255,0.92);
	}
	.sc-offers-list li strong { color: #ffffff; font-weight: 700; }
	.sc-offers-list li em { font-style: normal; color: #f7b98a; font-weight: 700; }
	.sc-offer-tag {
		flex: 0 0 auto;
		display: inline-block;
		background: rgba(62,190,223,0.16);
		color: #7ad4ec;
		font-size: 12px; font-weight: 800;
		text-transform: uppercase; letter-spacing: 1.2px;
		padding: 6px 13px;
		border-radius: 50px;
		margin-top: 1px;
	}
	.sc-offer-tag--value {
		background: rgba(232,119,34,0.18);
		color: #f5a869;
		letter-spacing: 0.6px;
	}
	.sc-offers-note {
		font-size: 14.5px; line-height: 1.65;
		color: rgba(255,255,255,0.72);
		margin: 0 0 30px;
		padding-top: 22px;
		border-top: 1px solid rgba(255,255,255,0.14);
	}
	.sc-offers-actions { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }

	@media (max-width: 900px) {
		.sc-offers-banner {
			grid-template-columns: 1fr;
			gap: 36px;
		}
		.sc-offers-collage { max-width: 440px; }
		/* Remove the vertical offsets when stacked so it sits tidily */
		.sc-collage-cell:nth-child(1),
		.sc-collage-cell:nth-child(4) { transform: none; }
	}

	@media (max-width: 720px) {
		.sc-promos { padding: 56px 0; }
		.sc-offers-banner { padding: 40px 26px 36px; border-radius: 16px; }
		.sc-offers-banner h2 { font-size: 27px; }
		.sc-offers-intro { font-size: 16px; }
		.sc-offers-actions .btn-book,
		.sc-offers-actions .btn-outline-white { width: 100%; text-align: center; }
	}
</style>
