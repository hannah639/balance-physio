---
import Layout from '../../layouts/Layout.astro';
import { getGlobals } from '../../lib/sanity/globals';
import PageHero from '../../components/PageHero.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import RichText from '../../components/RichText.astro';
import { services } from '../../lib/sanity/pageContent';

const doc = await services.required('outcome-measures');

const bookingUrl = (await getGlobals()).bookingUrl;

const faqs = doc.faqs.map((f) => ({ q: f.question, a: f.answer }));
---
<Layout
	title={doc.seoTitle ?? "Outcome Measures in Physiotherapy"}
	description={doc.seoDescription ?? "How Balance Performance Physiotherapy uses validated outcome measures (via Cemplicity) to track recovery objectively and guide rehabilitation decisions."}
>
	<PageHero
		title={doc.heroHeading}
		highlight={doc.heroHighlight ?? undefined}
		breadcrumb={doc.breadcrumb ?? undefined}
	/>

	<section class="text-grid text-grid--light text-grid--solo">
		<div class="text-grid-inner">
			<div class="image-text-content text-grid-cell">
				{doc.sections[0]?.eyebrow && <div class="eyebrow">{doc.sections[0].eyebrow}</div>}
				<h2>{doc.sections[0]?.heading}{doc.sections[0]?.headingHighlight && <> <span class="highlight">{doc.sections[0].headingHighlight}</span></>}</h2>
				<RichText blocks={doc.sections[0]?.blocks ?? []} />
				{doc.sections[0]?.ctaLabel && (
					<p><a href={doc.sections[0].ctaUrl ?? bookingUrl} class="btn-primary"
						target={doc.sections[0].ctaUrl ? undefined : "_blank"}
						rel={doc.sections[0].ctaUrl ? undefined : "noopener"}
					>{doc.sections[0].ctaLabel}</a></p>
				)}
			</div></div>
	</section>

	<section class="text-grid">
		<div class="text-grid-inner">
			<div class="image-text-content text-grid-cell text-grid-cell--treatment">
				{doc.sections[1]?.eyebrow && <div class="eyebrow">{doc.sections[1].eyebrow}</div>}
				<h2>{doc.sections[1]?.heading}{doc.sections[1]?.headingHighlight && <> <span class="highlight">{doc.sections[1].headingHighlight}</span></>}</h2>
				<RichText blocks={doc.sections[1]?.blocks ?? []} />
				{doc.sections[1]?.ctaLabel && (
					<p><a href={doc.sections[1].ctaUrl ?? bookingUrl} class="btn-primary"
						target={doc.sections[1].ctaUrl ? undefined : "_blank"}
						rel={doc.sections[1].ctaUrl ? undefined : "noopener"}
					>{doc.sections[1].ctaLabel}</a></p>
				)}
			</div><div class="image-text-content text-grid-cell text-grid-cell--treatment">
				{doc.sections[2]?.eyebrow && <div class="eyebrow">{doc.sections[2].eyebrow}</div>}
				<h2>{doc.sections[2]?.heading}{doc.sections[2]?.headingHighlight && <> <span class="highlight">{doc.sections[2].headingHighlight}</span></>}</h2>
				<RichText blocks={doc.sections[2]?.blocks ?? []} />
				{doc.sections[2]?.ctaLabel && (
					<p><a href={doc.sections[2].ctaUrl ?? bookingUrl} class="btn-primary"
						target={doc.sections[2].ctaUrl ? undefined : "_blank"}
						rel={doc.sections[2].ctaUrl ? undefined : "noopener"}
					>{doc.sections[2].ctaLabel}</a></p>
				)}
			</div><div class="image-text-content text-grid-cell text-grid-cell--treatment">
				{doc.sections[3]?.eyebrow && <div class="eyebrow">{doc.sections[3].eyebrow}</div>}
				<h2>{doc.sections[3]?.heading}{doc.sections[3]?.headingHighlight && <> <span class="highlight">{doc.sections[3].headingHighlight}</span></>}</h2>
				<RichText blocks={doc.sections[3]?.blocks ?? []} />
				{doc.sections[3]?.ctaLabel && (
					<p><a href={doc.sections[3].ctaUrl ?? bookingUrl} class="btn-primary"
						target={doc.sections[3].ctaUrl ? undefined : "_blank"}
						rel={doc.sections[3].ctaUrl ? undefined : "noopener"}
					>{doc.sections[3].ctaLabel}</a></p>
				)}
			</div><div class="image-text-content text-grid-cell text-grid-cell--treatment">
				{doc.sections[4]?.eyebrow && <div class="eyebrow">{doc.sections[4].eyebrow}</div>}
				<h2>{doc.sections[4]?.heading}{doc.sections[4]?.headingHighlight && <> <span class="highlight">{doc.sections[4].headingHighlight}</span></>}</h2>
				<RichText blocks={doc.sections[4]?.blocks ?? []} />
				{doc.sections[4]?.ctaLabel && (
					<p><a href={doc.sections[4].ctaUrl ?? bookingUrl} class="btn-primary"
						target={doc.sections[4].ctaUrl ? undefined : "_blank"}
						rel={doc.sections[4].ctaUrl ? undefined : "noopener"}
					>{doc.sections[4].ctaLabel}</a></p>
				)}
			</div></div>
	</section>

	<section class="text-grid text-grid--light text-grid--solo">
		<div class="text-grid-inner">
			<div class="image-text-content text-grid-cell">
				{doc.sections[5]?.eyebrow && <div class="eyebrow">{doc.sections[5].eyebrow}</div>}
				<h2>{doc.sections[5]?.heading}{doc.sections[5]?.headingHighlight && <> <span class="highlight">{doc.sections[5].headingHighlight}</span></>}</h2>
				<RichText blocks={doc.sections[5]?.blocks ?? []} />
				{doc.sections[5]?.ctaLabel && (
					<p><a href={doc.sections[5].ctaUrl ?? bookingUrl} class="btn-primary"
						target={doc.sections[5].ctaUrl ? undefined : "_blank"}
						rel={doc.sections[5].ctaUrl ? undefined : "noopener"}
					>{doc.sections[5].ctaLabel}</a></p>
				)}
			</div></div>
	</section>

	<section class="faq-section faq-section--alt">
		<div class="container">
			<div class="section-header"><h2>Frequently Asked Questions</h2></div>
			<div class="faq-list">
				{faqs.map((item) => (
					<details class="faq-item">
						<summary>{item.q}</summary>
						<div class="answer"><RichText blocks={item.a} /></div>
					</details>
				))}
			</div>
		</div>
	</section>

	<BookingCTA />
</Layout>
