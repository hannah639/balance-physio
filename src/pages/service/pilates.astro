---
import ServicePage from '../../components/ServicePage.astro';
import { services } from '../../lib/sanity/pageContent';

const doc = await services.required('pilates');
---
<ServicePage
	title={doc.heroHeading}
	highlight={doc.heroHighlight ?? undefined}
	heroSubtitle={doc.heroSubtitle ?? undefined}
	breadcrumb={doc.breadcrumb ?? undefined}
	seoTitle={doc.seoTitle ?? "Pilates in Clapham"}
	seoDescription={doc.seoDescription ?? "Pilates classes and one-to-one studio sessions in Clapham, London. Run by Pilates Sanctuary in partnership with Balance Performance Physiotherapy."}
	marqueeImages={doc.photoGallery.map((p) => ({ src: p.url, alt: p.alt }))}
	sections={doc.sections}
	faqs={doc.faqs.map((f) => ({ q: f.question, a: f.answer }))}
>
	<section slot="before-faq" class="pilates-booking">
		<div class="container">
			<div class="image-text-content pilates-booking-inner">
				<div class="eyebrow">Booking</div>
				<h2>Book a session at <span class="highlight">Pilates Sanctuary</span></h2>
				<p>To book a session of one-to-one teaching or join a small group, call one of the Pilates Sanctuary Directors directly:</p>
				<p><strong>Agur:</strong> <a href="tel:+447824901063">07824 901 063</a><br/>
				<strong>Alice:</strong> <a href="tel:+447881953843">07881 953 843</a></p>
				<p>For general Balance enquiries: <a href="mailto:admin@balancephysio.com">admin@balancephysio.com</a></p>
			</div>
		</div>
	</section>

	<style>
		.pilates-booking {
			padding: 80px 0;
			background: linear-gradient(135deg, #fdf3ed 0%, #fbe6d9 50%, #fce8d4 100%);
		}
		.pilates-booking-inner {
			max-width: 720px;
			margin: 0 auto;
			text-align: center;
		}
		.pilates-booking h2 { margin-bottom: 16px; }
		.pilates-booking p { margin: 12px 0; }
	</style>
</ServicePage>
