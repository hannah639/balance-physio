# Template for .env — copy to .env and fill in real values.
# .env is git-ignored; this example file is committed so new developers know
# which variables the project expects.
#
# The SANITY_* vars carry no PUBLIC_ prefix, so Astro keeps them server-only
# (build-time / SSR). The read token must never become a PUBLIC_ var.

SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19

# Viewer/read token from sanity.io/manage → API → Tokens.
# Required only for private datasets or reading drafts. Keep it secret.
SANITY_API_READ_TOKEN=

# Google Ads conversion ID, e.g. 17788943816 (the "AW-" prefix is added in
# code, so either form works). PUBLIC_ on purpose: Vite inlines it into the
# browser bundle, which is where a conversion tag has to run. It is a public
# identifier, not a secret.
#
# Read at BUILD time, so it must ALSO be set in Cloudflare → Workers & Pages →
# balancephysio → Settings → Environment variables. Without it the tag is
# silently absent in production.
#
# The tag only fires after cookie consent, alongside GA and GTM.
PUBLIC_ADS_CONVERSION_ID=

# Cloudflare Workers build deploy hook. POSTing to it triggers a production
# build + deploy. Used by the Sanity → Cloudflare rebuild webhook; no code
# calls it. Treat as a secret — anyone with the URL can deploy.
CLOUDFLARE_DEPLOY_HOOK_URL=
